module: arcana-packages
  +--ro packages
     +--ro package* [name]
     |  +--ro name             string
     |  +--ro installed?       string
     |  +--ro available?       string
     |  +--ro automatic?       boolean
     |  +--ro comment?         string
     |  +--ro size?            uint64
     |  +--ro origin?          string
     |  +--ro vulnerable?      boolean
     |  +--ro vulnerability*   string
     +--ro repository*       string
     +--ro pkgbase?          boolean
     +--ro pkgbase-jail*     string
     +--ro audit-error?      string
     +--ro jail-pkg?         boolean
     +--ro bootstrap-jail?   boolean
     +---x read
     |  +--ro output
     |     +--ro package* [name]
     |     |  +--ro name             string
     |     |  +--ro installed?       string
     |     |  +--ro available?       string
     |     |  +--ro automatic?       boolean
     |     |  +--ro comment?         string
     |     |  +--ro size?            uint64
     |     |  +--ro origin?          string
     |     |  +--ro vulnerable?      boolean
     |     |  +--ro vulnerability*   string
     |     +--ro repository*       string
     |     +--ro pkgbase?          boolean
     |     +--ro pkgbase-jail*     string
     |     +--ro audit-error?      string
     |     +--ro jail-pkg?         boolean
     |     +--ro bootstrap-jail?   boolean
     +---x refresh
     |  +---w input
     |  |  +---w ip-version?         ip-version
     |  |  +---w update?             boolean
     |  |  +---w ignore-osversion?   boolean
     |  |  +---w no-repo-check?      boolean
     |  +--ro output
     |     +--ro package* [name]
     |     |  +--ro name             string
     |     |  +--ro installed?       string
     |     |  +--ro available?       string
     |     |  +--ro automatic?       boolean
     |     |  +--ro comment?         string
     |     |  +--ro size?            uint64
     |     |  +--ro origin?          string
     |     |  +--ro vulnerable?      boolean
     |     |  +--ro vulnerability*   string
     |     +--ro repository*       string
     |     +--ro pkgbase?          boolean
     |     +--ro pkgbase-jail*     string
     |     +--ro audit-error?      string
     |     +--ro jail-pkg?         boolean
     |     +--ro bootstrap-jail?   boolean
     +---x upgrade
        +---w input
        |  +---w name*               string
        |  +---w dry-run?            boolean
        |  +---w ignore-osversion?   boolean
        |  +---w ip-version?         ip-version
        |  +---w repository?         string
        |  +---w every-jail?         boolean
        |  +---w no-repo-check?      boolean
        +--ro output
           +--ro upgraded?   uint32
           +--ro package* [name]
              +--ro name             string
              +--ro installed?       string
              +--ro available?       string
              +--ro automatic?       boolean
              +--ro comment?         string
              +--ro size?            uint64
              +--ro origin?          string
              +--ro vulnerable?      boolean
              +--ro vulnerability*   string

  augment /arcj:jails/arcj:jail:
    +---u packages
