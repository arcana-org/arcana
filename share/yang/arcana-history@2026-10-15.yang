module arcana-history {
  yang-version 1.1;
  namespace "urn:arcana:yang:arcana-history";
  prefix archist;

  import cblink-gen {
    prefix cg;
  }
  import ietf-yang-types {
    prefix yang;
    reference
      "RFC 9911: Common YANG Data Types";
  }

  organization
    "Arcana";
  contact
    "Pouria Mousavizadeh Tehrani <pouria@FreeBSD.org>";
  description
    "How busy a FreeBSD host has been, which the agent samples by
     itself and keeps the last of: CPU (kern.cp_time), the load
     average (getloadavg(3)), memory and swap in use (vm.stats.vm,
     kvm_getswapinfo(3)), bytes a second in and out of each interface
     but the loopback (getifaddrs(3)) and read from and written to
     each disk (devstat(3)), and each running jail's share of a CPU
     and memory as the kernel's resource accounting has them
     (rctl(8), kern.racct.enable=1), and each FEC relay's (UDPspeeder,
     net/udpspeeder) rates as its --report lines in syslog(3) have
     them.  How it samples (step, keep) and
     the limits above which an event (threshold) is made are
     configuration, kept for the agent's next start; the samples are
     state, written down when the agent stops and read again when it
     starts.  The archive keeps their long run on the disk by class,
     the host's, each interface's, disk's, jail's and relay's, and each
     probe target's, read by read-archive (PLAN-SDN-YANG 5.6.3).  The
     history operation of arcana.yaml converted (Y-3).";

  revision 2026-10-15 {
    description
      "Initial revision.";
  }

  typedef archive-class {
    type enumeration {
      enum host {
        description
          "The host's figures, one series, host: CPU in tenths of a
           percent, the load in hundredths, memory and swap in bytes,
           the totals in bytes a second.";
      }
      enum interface {
        description
          "Each interface told apart, a series by its name: in and out,
           bytes a second.";
      }
      enum disk {
        description
          "Each disk: read and written, bytes a second.";
      }
      enum jail {
        description
          "Each jail: its CPU in tenths of a percent of one, its memory
           in bytes.";
      }
      enum relay {
        description
          "Each FEC relay: plain and added, bytes a second.";
      }
      enum probe {
        description
          "Each probe target, a series by its name (id, id@jail at a
           jail's edge, /class for a class's session): delays in
           microseconds, loss in ten-thousandths, probes sent and
           received.";
      }
    }
    description
      "A class of the archive.";
  }

  typedef percent {
    type decimal64 {
      fraction-digits 1;
      range "0..100";
    }
    description
      "A percentage.";
  }

  grouping sample {
    description
      "One sample.";
    leaf time {
      type yang:date-and-time;
      description
        "When it was taken.";
    }
    leaf cpu {
      type percent;
      description
        "CPU busy, of all CPUs.";
    }
    leaf load {
      type decimal64 {
        fraction-digits 2;
      }
      description
        "The one-minute load average.";
    }
    leaf memory {
      type uint64;
      units "bytes";
      description
        "Memory in use.";
    }
    leaf swap {
      type uint64;
      units "bytes";
      description
        "Swap in use.";
    }
    leaf received {
      type uint64;
      units "bytes/second";
      description
        "Received on all interfaces but the loopback.";
    }
    leaf sent {
      type uint64;
      units "bytes/second";
      description
        "Sent on them.";
    }
    leaf read {
      type uint64;
      units "bytes/second";
      description
        "Read from all disks.";
    }
    leaf written {
      type uint64;
      units "bytes/second";
      description
        "Written to them.";
    }
    list interface {
      key "name";
      description
        "Each interface told apart, at most 16.";
      leaf name {
        type string;
        description
          "The interface.";
      }
      leaf received {
        type uint64;
        units "bytes/second";
        description
          "In.";
      }
      leaf sent {
        type uint64;
        units "bytes/second";
        description
          "Out.";
      }
    }
    list disk {
      key "name";
      description
        "Each disk told apart, at most 16.";
      leaf name {
        type string;
        description
          "The disk.";
      }
      leaf read {
        type uint64;
        units "bytes/second";
        description
          "Read.";
      }
      leaf written {
        type uint64;
        units "bytes/second";
        description
          "Written.";
      }
    }
    list jail {
      key "name";
      description
        "Each running jail told apart, at most 16, as the kernel's
         resource accounting has it.";
      leaf name {
        type string;
        description
          "The jail.";
      }
      leaf cpu {
        type percent;
        description
          "Its share of one CPU.";
      }
      leaf memory {
        type uint64;
        units "bytes";
        description
          "Its memory.";
      }
    }
    list relay {
      key "name";
      description
        "Each FEC relay told apart, at most 16, by its syslog tag:
         arcana_relay, or arcana_relay_<profile> for one of several
         (Arcana's rc script's), or speederv2, the admin's.  Its
         figures are those of its last --report interval, both ways
         summed, while its last report is fresh; zero else.";
      leaf name {
        type string;
        description
          "The relay's tag.";
      }
      leaf plain {
        type uint64;
        units "bytes/second";
        description
          "Taken in plain: the tunnel's traffic as the relay carries
           it.";
      }
      leaf added {
        type uint64;
        units "bytes/second";
        description
          "Added to it by the FEC: its overhead, the redundant packets
           and their headers.";
      }
    }
  }

  grouping history-settings {
    description
      "How the agent samples, and its limits.";
    container sampling {
      description
        "How the agent samples, kept for its next start: an hour
         every five seconds until told otherwise.";
      leaf step {
        type uint16 {
          range "1..3600";
        }
        units "seconds";
        default "5";
        description
          "Seconds between two samples.";
      }
      leaf keep {
        type uint32 {
          range "0..5000";
        }
        default "720";
        description
          "How many samples are kept; 0, none taken.";
      }
      leaf hold {
        type uint16 {
          range "0..3600";
        }
        units "seconds";
        default "60";
        description
          "How long a figure stays over its limit before it is over
           (an event, threshold, and for cpu, memory and storage a
           fault), and under it again before it is back under; 0, at
           the first sample that crosses.  The limits below and the
           rules alike.";
      }
      leaf enabled {
        type boolean;
        default "true";
        description
          "Whether the host is sampled at all.  Off, no sample is
           taken, no limit judged and no event or fault made of one;
           a resource fault raised before is cleared once; the
           samples kept stay, to be read, until it is on again.";
      }
    }
    container limits {
      description
        "The percentages above which an event (threshold) is made,
         either way across; 0 none.";
      leaf cpu {
        type uint8 {
          range "0..100";
        }
        description
          "CPU busy.";
      }
      leaf memory {
        type uint8 {
          range "0..100";
        }
        description
          "Memory in use, of the whole.";
      }
      leaf swap {
        type uint8 {
          range "0..100";
        }
        description
          "Swap in use, of the whole.";
      }
      leaf storage {
        type uint8 {
          range "0..100";
        }
        description
          "A file system full (a ZFS pool's allocated share, another
           local one's as df has it), looked at each minute; over it
           also a storage fault.";
      }
    }
    list rule {
      key "kind name";
      description
        "A limit of one interface, disk or jail.";
      leaf kind {
        type enumeration {
          enum net {
            description
              "An interface: bytes a second, in and out together.";
          }
          enum disk {
            description
              "A disk: bytes a second, read and written together.";
          }
          enum jail-cpu {
            description
              "A jail's share of one CPU, in percent.";
          }
          enum jail-mem {
            description
              "A jail's memory, in bytes.";
          }
        }
        description
          "What is limited.";
      }
      leaf name {
        type string;
        description
          "The interface's, the disk's or the jail's name.";
      }
      leaf limit {
        type uint64;
        description
          "The limit, in the kind's unit.";
      }
      leaf over {
        type boolean;
        config false;
        description
          "Over it at the last sample.";
      }
    }
    container archive {
      description
        "The archive, the long run of the samples on the host's disk
         (archive beside history.conf, or the agent's --archive):
         each class's series, a point every step seconds (the
         samples within one merged: the mean of each figure, the least
         of the least, the most of the most, the sum of the probes
         sent and received), a file a day, each class's days kept for
         its retention and the whole within its budget, the oldest day
         of any class going first.";
      leaf enabled {
        type boolean;
        default "true";
        description
          "Whether the samples are archived.  Off, the files kept stay
           to be read.";
      }
      leaf budget {
        type uint32 {
          range "1..1048576";
        }
        units "mebibytes";
        default "128";
        description
          "The most the archive takes on the disk.  A class whose day
           under way alone keeps it over is archived no more until
           the next day (UTC).";
      }
      list class {
        key "name";
        description
          "A class's step and retention; a class not here, or a leaf
           not said, has its default.";
        leaf name {
          type archive-class;
          description
            "The class.";
        }
        leaf step {
          type uint16 {
            range "10..3600";
          }
          units "seconds";
          description
            "What a point stands for; 60 unless said.";
        }
        leaf retention {
          type uint16 {
            range "1..3660";
          }
          units "days";
          description
            "How many days are kept, today's among them: 30 of host
             unless said, 7 of the others.";
        }
      }
    }
  }

  grouping archive-totals {
    description
      "The archive as it is.";
    container archive {
      description
        "What the archive holds.";
      leaf bytes {
        type uint64;
        units "bytes";
        description
          "Its files, all told.";
      }
      leaf budget {
        type uint64;
        units "bytes";
        description
          "The most they may take.";
      }
      list class {
        key "name";
        description
          "Each class.";
        leaf name {
          type archive-class;
          description
            "The class.";
        }
        leaf bytes {
          type uint64;
          units "bytes";
          description
            "Its files.";
        }
        leaf files {
          type uint32;
          description
            "How many days it has.";
        }
        leaf series {
          type uint32;
          description
            "The series the agent has archived since it started.";
        }
        leaf oldest {
          type yang:date-and-time;
          description
            "The start of its oldest day.";
        }
        leaf step {
          type uint16;
          units "seconds";
          description
            "What a point stands for.";
        }
        leaf retention {
          type uint16;
          units "days";
          description
            "How many days are kept.";
        }
        leaf full {
          type boolean;
          description
            "Archived no more until tomorrow: the budget is reached
             with today's files alone.";
        }
      }
    }
  }

  grouping history-totals {
    description
      "The sampler as it is, but its samples.";
    leaf bytes {
      type uint64;
      units "bytes";
      description
        "The memory the samples take.";
    }
    leaf ncpu {
      type uint16;
      description
        "How many CPUs the host has.";
    }
    leaf memory-total {
      type uint64;
      units "bytes";
      description
        "The host's memory.";
    }
    leaf swap-total {
      type uint64;
      units "bytes";
      description
        "Its swap.";
    }
    leaf racct {
      type boolean;
      description
        "The kernel accounts resources per jail
         (kern.racct.enable).";
    }
    leaf-list interface {
      type string;
      description
        "The interfaces told apart.";
    }
    leaf-list disk {
      type string;
      description
        "The disks told apart.";
    }
    leaf-list jail {
      type string;
      description
        "The jails told apart.";
    }
    leaf-list relay {
      type string;
      description
        "The FEC relays told apart.";
    }
  }

  container history {
    description
      "The sampler and what it kept.";
    uses history-settings;
    container state {
      config false;
      description
        "The sampler as it is.";
      uses history-totals;
      uses archive-totals;
      list sample {
        cg:struct "sample";
        key "time";
        description
          "The samples kept, oldest first.";
        uses sample;
      }
    }
    action read {
      description
        "The samples after a time, with how they are taken and the
         sampler as it is: what a page that has the ones before asks
         for.";
      input {
        leaf after {
          type yang:date-and-time;
          description
            "Only samples taken after this.";
        }
      }
      output {
        uses history-settings;
        uses history-totals;
        list sample {
          cg:struct "sample";
          key "time";
          description
            "The samples, oldest first.";
          uses sample;
        }
      }
    }
    action read-archive {
      description
        "A class's points from the archive between two times, each
         series given at most so many: the archive's points merged
         into longer ones, a multiple of the class's step, when there
         are more.  The point under way is not written yet.";
      input {
        leaf class {
          type archive-class;
          mandatory true;
          description
            "The class.";
        }
        leaf name {
          type string {
            length "1..255";
          }
          description
            "One series; all of the class when not said.";
        }
        leaf from {
          type yang:date-and-time;
          description
            "From when; a day before to unless said.";
        }
        leaf to {
          type yang:date-and-time;
          description
            "To when; now unless said.";
        }
        leaf points {
          type uint16 {
            range "1..10000";
          }
          default "1000";
          description
            "The most points a series is given.  The points of every
             series together are at most 100000.";
        }
      }
      output {
        leaf step {
          type uint32;
          units "seconds";
          description
            "What a point stands for.";
        }
        leaf-list field {
          type string;
          ordered-by user;
          description
            "What each value of a point is.";
        }
        leaf-list scale {
          type uint32;
          ordered-by user;
          description
            "What each field's value is divided by to be in its unit:
             10 for CPU in tenths of a percent, 1000 for a delay in
             microseconds to be in milliseconds, 10000 for a loss in
             ten-thousandths to be a ratio.";
        }
        list series {
          key "name";
          description
            "Each series that has a point.";
          leaf name {
            type string;
            description
              "The series.";
          }
          list point {
            description
              "Its points, oldest first.";
            leaf time {
              type yang:date-and-time;
              description
                "The start of what it stands for.";
            }
            leaf-list value {
              type int64;
              ordered-by user;
              description
                "Its values, as field names them; -1 when none of the
                 samples told it.";
            }
          }
        }
      }
    }
  }
}
