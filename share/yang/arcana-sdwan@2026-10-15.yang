module arcana-sdwan {
  yang-version 1.1;
  namespace "urn:arcana:yang:arcana-sdwan";
  prefix arcsd;

  import cblink-gen {
    prefix cg;
  }
  import ietf-netconf-acm {
    prefix nacm;
    reference
      "RFC 8341: Network Configuration Access Control Model";
  }
  import ietf-inet-types {
    prefix inet;
    reference
      "RFC 9911: Common YANG Data Types";
  }
  import ietf-yang-types {
    prefix yang;
    reference
      "RFC 9911: Common YANG Data Types";
  }
  import arcana-firewall {
    prefix arcfw;
  }

  organization
    "Arcana";
  contact
    "Pouria Mousavizadeh Tehrani <pouria@FreeBSD.org>";
  description
    "A FreeBSD host as an SD-WAN edge (MEF 70.2, Mplify 119), what the
     console writes to it and what it tells back: the rules that
     classify what comes in at the UNIs and steer it (an ipfw set of
     their own, tables, dummynet and NAT objects); the policy tables'
     candidates in the console's order, the first whose far end the
     probes do not say is down chosen; the BIRD, dnsmasq, unbound (MEF
     138's DNF and PDNS), Squid (MEF 138's URLF, MBSF and MD+R, with a
     CA of its own where TLS is opened) and Suricata (the ids
     criterion) instances of the services, one each in its FIB
     (setfib), and the Security section's Squid and Suricata (named
     sec-), as the console writes them, each from its form as this
     module says it, the text the agent rendered of it its state; the
     rules, steering and BIRD of each edge that is a vnet jail under
     jail; and as state what each
     is doing, the security policies' record (ipfw's logdst rtsock),
     the IPsec keys of the tunnels (sdwan-key-*.pem) and the faults of
     the day (Mplify 119 §11.3).  Written by EDIT and a commit: what
     changed of an edge is applied as the operations did, the rules
     and the steering each swapped whole.  The sdwan, sdwan-rules,
     sdwan-steer, sdwan-bird, sdwan-dhcp, sdwan-dns, sdwan-proxy and
     sdwan-ids operations of arcana.yaml converted (Y-3) and retired;
     the probes are arcana-probe's.";

  revision 2026-10-15 {
    description
      "Initial revision.";
  }

  typedef far-state {
    type enumeration {
      enum up {
        description
          "Up.";
      }
      enum down {
        description
          "Down.";
      }
      enum unknown {
        description
          "Not yet known.";
      }
      enum not-probed {
        description
          "No probe watches it.";
      }
    }
    description
      "A tunnel's far end, as the probes see it.";
  }

  grouping candidate-state {
    description
      "A candidate of the steering, as it is.";
    leaf id {
      type string;
      description
        "The tunnel.";
    }
    leaf via {
      type inet:ip-address-no-zone;
      description
        "Its address.";
    }
    leaf state {
      type far-state;
      description
        "As the probes see it.";
    }
  }

  grouping edge-state {
    description
      "An edge's rules as the kernel has them, and its steering.";
    container rules {
      cg:struct "rules";
      description
        "The rules as the kernel has them.";
      leaf set {
        type uint8;
        description
          "Their set.";
      }
      leaf rules {
        type uint32;
        description
          "How many.";
      }
      leaf objects {
        type uint32;
        description
          "How many objects.";
      }
      list table {
        key "name";
        description
          "The tables, and what each holds.";
        leaf name {
          type string;
          description
            "The table.";
        }
        leaf count {
          type uint32;
          description
            "Its entries.";
        }
      }
      list counter {
        key "rule";
        description
          "Each rule's counters.";
        leaf rule {
          type arcfw:rule-number;
          description
            "The rule.";
        }
        leaf packets {
          type uint64;
          description
            "Packets it matched.";
        }
        leaf octets {
          type uint64;
          description
            "Their bytes.";
        }
        leaf text {
          type string;
          description
            "Its words.";
        }
      }
    }
    leaf steered {
      type boolean;
      description
        "The policy tables are filled as the steer says.";
    }
    list steer {
      cg:struct "steer";
      key "table prefix";
      description
        "What the policy tables hold now.";
      leaf table {
        type string;
        description
          "The table.";
      }
      leaf prefix {
        type string;
        description
          "The prefix.";
      }
      leaf chosen {
        type int32;
        description
          "Which candidate is in the table, by its place; -1
           none.";
      }
      list candidate {
        key "id";
        ordered-by user;
        description
          "The candidates, with what the probes say of each.";
        uses candidate-state;
        leaf bfd {
          type far-state;
          description
            "As BFD sees its address, where a session watches it.";
        }
      }
    }
    list route {
      cg:struct "steered-route";
      description
        "The breakout's routes steered: each a destination of a FIB
         and its candidates, the first not down in the table.";
      leaf fib {
        type uint16;
        description
          "The FIB.";
      }
      leaf destination {
        type string;
        description
          "The destination.";
      }
      leaf chosen {
        type int32;
        description
          "Which candidate is the route, by its place; -1 none.";
      }
      list candidate {
        key "id";
        ordered-by user;
        description
          "The candidates.";
        uses candidate-state;
      }
    }
    list alt-marking {
      cg:struct "altmark-tunnel";
      key "tunnel";
      description
        "Each tunnel measured by alternate marking (RFC 9341, single
         marking, the colour the DSCP's lowest bit), its last blocks:
         what went into it at this end and came out of it here, of
         each block's colour, as ipfw's count rules (rules 9 and 11 of the
         set) counted, read by IP_FW3 in the middle of the block
         after.  The console subtracts the far end's packets in from
         this end's packets out.";
      leaf tunnel {
        type string;
        description
          "The tunnel.";
      }
      leaf service {
        type string;
        description
          "Its service.";
      }
      leaf interface {
        type string;
        description
          "Its interface at this end.";
      }
      leaf period {
        type uint16;
        units "seconds";
        description
          "A block's length, L.";
      }
      leaf colour {
        type uint8 {
          range "0..1";
        }
        description
          "The colour marked now: the block's number's lowest bit.";
      }
      leaf current {
        type uint64;
        description
          "The block now: the wall clock's seconds since the epoch
           over the period.";
      }
      list block {
        key "number";
        description
          "The blocks read, oldest first.";
        leaf number {
          type uint64;
          description
            "Its number: its start over the period.";
        }
        leaf start {
          type yang:date-and-time;
          description
            "Its start.";
        }
        leaf colour {
          type uint8 {
            range "0..1";
          }
          description
            "Its colour.";
        }
        leaf out-packets {
          type uint64;
          description
            "Packets that went into the tunnel at this end.";
        }
        leaf out-octets {
          type uint64;
          description
            "Their bytes.";
        }
        leaf in-packets {
          type uint64;
          description
            "Packets that came out of it at this end.";
        }
        leaf in-octets {
          type uint64;
          description
            "Their bytes.";
        }
        leaf read-offset {
          type uint32;
          units "milliseconds";
          description
            "When it was read, from the next block's start: L/2 when
             on time.";
        }
        leaf swap-delay {
          type uint32;
          units "milliseconds";
          description
            "How late the colour table was swapped at the next block's
             start.";
        }
        leaf valid {
          type boolean;
          description
            "Read within the guard band: between L/4 and 3L/4 of the
             next block, its swap within L/4 of its start.";
        }
      }
    }
  }

  typedef allow-block {
    type enumeration {
      enum allow {
        description
          "Let through.";
      }
      enum block {
        description
          "Stopped.";
      }
    }
    description
      "An action of a function policy (MEF 138 §6.1.3).";
  }

  typedef sfp-list {
    type enumeration {
      enum block {
        description
          "Its Block list.";
      }
      enum quarantine {
        description
          "Its Quarantine list.";
      }
      enum allow {
        description
          "Its Allow list.";
      }
    }
    description
      "A list of a function policy's (MEF 138 §6.1.6).";
  }

  typedef community {
    type string {
      pattern '[0-9]{1,5}:[0-9]{1,5}';
    }
    description
      "A BGP community (RFC 1997): its two halves, each 0 to 65535,
       as AS:value.";
  }

  typedef family {
    type enumeration {
      enum ipv4 {
        description
          "IPv4 alone.";
      }
      enum ipv6 {
        description
          "IPv6 alone.";
      }
      enum both {
        description
          "Both.";
      }
    }
    description
      "The families a session or an area is for (MEF 70.2 §11.6,
       R139).";
  }

  grouping sfp-lists {
    description
      "The lists of a function policy whose entries are words: its
       own, then the named lists' as the console resolved them.";
    leaf-list block {
      type string;
      description
        "Block.";
    }
    leaf-list quarantine {
      type string;
      description
        "Quarantine, blocked too (MEF 138 §6.1.3).";
    }
    leaf-list allow {
      type string;
      description
        "Allow.";
    }
  }

  grouping sfp-common {
    description
      "What every function policy has (MEF 138 §6.1).";
    leaf no-match {
      type allow-block;
      description
        "What is on no list (R68-R70).";
    }
    leaf-list notify {
      type sfp-list;
      description
        "The lists whose matches are told (R20); none said, Block and
         Quarantine (R21).";
    }
    leaf id {
      type string;
      description
        "The policy's ID, which what the daemon blocked is named by.";
    }
  }

  grouping sfp-form {
    description
      "A function policy whose entries are words: a DNF's domains, a
       URLF's URLs, an MD+R's hashes.";
    uses sfp-common;
    uses sfp-lists;
    container listed {
      description
        "The named lists' entries, by list.";
      uses sfp-lists;
    }
  }

  grouping pdns-entries {
    description
      "The entries of a PDNS list: a type and a value each (MEF 138
       Table 8).";
    leaf type {
      type enumeration {
        enum A {
          description
            "An IPv4 address in an answer.";
        }
        enum AAAA {
          description
            "An IPv6 address in an answer.";
        }
        enum CNAME {
          description
            "The name an alias leads to.";
        }
        enum NS {
          description
            "A name server's name or address.";
        }
      }
      description
        "What of an answer it is matched against (R104).";
    }
    leaf value {
      type string;
      description
        "A prefix, any, or a name.";
    }
  }

  grouping pdns-form {
    description
      "A PDNS function policy (MEF 138 §6.1.11).";
    uses sfp-common;
    list block {
      key "type value";
      description
        "Block.";
      uses pdns-entries;
    }
    list quarantine {
      key "type value";
      description
        "Quarantine.";
      uses pdns-entries;
    }
    list allow {
      key "type value";
      description
        "Allow.";
      uses pdns-entries;
    }
    container listed {
      description
        "The named lists' prefixes, by list.";
      uses sfp-lists;
    }
  }

  grouping mbsf-form {
    description
      "An MBSF function policy (MEF 138 Table 9).";
    leaf no-match {
      type allow-block;
      description
        "What a version on no list has.";
    }
    leaf-list block {
      type string;
      description
        "The protocol versions blocked: ssl3, tls1.0 to tls1.3.";
    }
    leaf-list allow {
      type string;
      description
        "The protocol versions let through.";
    }
    leaf-list pass-through {
      type string;
      description
        "The hosts never opened.";
    }
    leaf invalid-server-certificate {
      type allow-block;
      description
        "A server's certificate not trusted.";
    }
    leaf unencrypted {
      type allow-block;
      description
        "Cleartext HTTP.";
    }
    leaf id {
      type string;
      description
        "The policy's ID.";
    }
  }

  grouping routing-form {
    description
      "BGP and OSPF with a neighbour at an interface, as a UNI's or a
       UCS End Point's routing has them (MEF 70.2 §11.6.2, §11.6.3;
       Mplify 119 §12.2.3.5): an entry each, or several (an area per
       family, BGP neighbours of their own AS).";
    list bgp {
      key "index";
      description
        "The BGP sessions.";
      leaf index {
        type uint8;
        description
          "The entry's place.";
      }
      leaf family {
        type family;
        description
          "Its families.";
      }
      leaf as {
        type uint32 {
          range "1..max";
        }
        description
          "The neighbours' AS; the instance's own makes it iBGP, next
           hop self.";
      }
      leaf-list neighbors {
        type inet:ip-address-no-zone;
        description
          "The neighbours' addresses.";
      }
      leaf source {
        type inet:ip-address-no-zone;
        description
          "This edge's address the sessions are from (a loopback's):
           multihop.";
      }
      leaf multihop {
        type boolean;
        description
          "Not across the interface alone.";
      }
      leaf bfd {
        type boolean;
        description
          "Watched by BFD.";
      }
      leaf distance {
        type uint8 {
          range "1..255";
        }
        description
          "Its routes' distance, the lower the better (R140-R142).";
      }
      leaf hold-time {
        type uint16;
        units "seconds";
        description
          "The hold time.";
      }
      leaf password {
        type string;
        description
          "TCP MD5's.";
      }
      leaf-list communities {
        type community;
        description
          "The communities agreed, added to what goes to the
           neighbours.";
      }
    }
    list ospf {
      key "index";
      description
        "The OSPF areas.";
      leaf index {
        type uint8;
        description
          "The entry's place.";
      }
      leaf family {
        type family;
        description
          "Its families: OSPFv2, OSPFv3 or both.";
      }
      leaf area {
        type uint32;
        description
          "The area, 0 the backbone.";
      }
      leaf cost {
        type uint16 {
          range "1..max";
        }
        description
          "The interface's cost.";
      }
      leaf hello {
        type uint16 {
          range "1..max";
        }
        units "seconds";
        description
          "The hello interval.";
      }
      leaf dead {
        type uint16 {
          range "1..max";
        }
        units "seconds";
        description
          "The dead interval.";
      }
      leaf bfd {
        type boolean;
        description
          "Watched by BFD.";
      }
      leaf distance {
        type uint8 {
          range "1..255";
        }
        description
          "Its routes' distance.";
      }
      leaf password {
        type string;
        description
          "Cryptographic authentication's.";
      }
    }
  }

  grouping bird-form {
    description
      "The form BIRD's file of an instance is rendered from (luxuria
       sdconf.c): an SD-WAN service's at this edge, or a UCS End
       Point's (flavor ucs).";
    leaf flavor {
      type enumeration {
        enum sdwan {
          description
            "An SD-WAN service's.";
        }
        enum ucs {
          description
            "A UCS End Point's, routing with the underlay.";
        }
      }
      description
        "Whose; none an SD-WAN service's.";
    }
    leaf service {
      type string;
      description
        "The service.";
    }
    leaf end-point {
      type string;
      description
        "The UCS End Point.";
    }
    leaf fib {
      type uint32;
      description
        "The service's FIB, for the file's comment.";
    }
    leaf table {
      type uint32;
      description
        "The kernel table BIRD learns and writes.";
    }
    leaf as {
      type uint32 {
        range "1..max";
      }
      description
        "Its AS.";
    }
    leaf router-id {
      type inet:ipv4-address-no-zone;
      description
        "Its router id.";
    }
    leaf interface {
      type string;
      description
        "The UCS End Point's interface.";
    }
    uses routing-form;
    leaf-list direct {
      type string;
      description
        "The interfaces whose connected routes it takes.";
    }
    leaf loopback {
      type boolean;
      description
        "The iBGP between the edges' loopbacks (loop).";
    }
    container route-monitoring {
      presence
        "Its BGP updates to the agent by BMP (RFC 7854).";
      description
        "BMP to the agent's station of its table.";
      leaf kept {
        type uint16 {
          range "1..1024";
        }
        description
          "The updates the agent keeps.";
      }
    }
    container bfd {
      presence
        "BFD on the tunnels.";
      description
        "BFD on the tunnel interfaces here and the UNIs whose
         neighbours it watches (R58, R59, R159).";
      leaf-list interfaces {
        type string;
        description
          "The interfaces.";
      }
      leaf interval {
        type uint16 {
          range "1..60000";
        }
        units "milliseconds";
        description
          "The interval.";
      }
      leaf multiplier {
        type uint8 {
          range "1..max";
        }
        description
          "The multiplier.";
      }
      leaf multihop {
        type boolean;
        description
          "Multihop sessions watched too.";
      }
      leaf sessions {
        type boolean;
        description
          "The iBGP sessions go down with it.";
      }
    }
    leaf-list reject {
      type string;
      description
        "The prefixes not sent to the other edges.";
    }
    leaf md5 {
      type string;
      description
        "TCP MD5 on the iBGP sessions (Mplify 119 R11, R12).";
    }
    container sets {
      presence
        "The breakout chosen by BGP attribute.";
      description
        "The destination sets by BGP attribute, each by the uplink
         named for it.";
      leaf only {
        type boolean;
        description
          "No other BGP route reaches the kernel.";
      }
      list sets {
        key "name";
        description
          "The sets.";
        leaf name {
          type string;
          description
            "The set.";
        }
        leaf via {
          type string;
          description
            "The UCS End Point named for it.";
        }
        leaf gateway {
          type inet:ip-address-no-zone;
          description
            "Its gateway.";
        }
        leaf-list as-path {
          type uint32;
          description
            "The AS numbers a route's path is matched against.";
        }
        leaf-list communities {
          type community;
          description
            "The communities it is matched against.";
        }
      }
    }
    container loop {
      presence
        "The iBGP between loopbacks.";
      description
        "iBGP between the edges' loopbacks.";
      leaf local4 {
        type inet:ipv4-address-no-zone;
        description
          "This edge's IPv4 loopback.";
      }
      leaf local6 {
        type inet:ipv6-address-no-zone;
        description
          "This edge's IPv6 loopback.";
      }
      leaf transit {
        type boolean;
        description
          "This edge reflects.";
      }
      list edges {
        key "name";
        description
          "The other edges.";
        leaf name {
          type string;
          description
            "The edge.";
        }
        leaf ipv4 {
          type inet:ipv4-address-no-zone;
          description
            "Its IPv4 loopback.";
        }
        leaf ipv6 {
          type inet:ipv6-address-no-zone;
          description
            "Its IPv6 loopback.";
        }
        leaf-list paths4 {
          type inet:ip-address-no-zone;
          description
            "The tunnels' far inner IPv4 addresses.";
        }
        leaf-list backup4 {
          type inet:ip-address-no-zone;
          description
            "The backup tunnels'.";
        }
        leaf-list paths6 {
          type inet:ip-address-no-zone;
          description
            "The tunnels' far inner IPv6 addresses.";
        }
        leaf-list backup6 {
          type inet:ip-address-no-zone;
          description
            "The backup tunnels'.";
        }
      }
      list origins {
        key "id";
        description
          "This edge's own prefixes, by end point.";
        leaf id {
          type string;
          description
            "The end point.";
        }
        leaf interface {
          type string;
          description
            "Its interface.";
        }
        list ipv4 {
          key "prefix";
          description
            "Its IPv4 routes.";
          leaf prefix {
            type string;
            description
              "The prefix.";
          }
          leaf next-hop {
            type inet:ip-address-no-zone;
            description
              "Its next hop; none, the interface.";
          }
        }
        list ipv6 {
          key "prefix";
          description
            "Its IPv6 routes.";
          leaf prefix {
            type string;
            description
              "The prefix.";
          }
          leaf next-hop {
            type inet:ip-address-no-zone;
            description
              "Its next hop; none, the interface.";
          }
        }
      }
    }
    list peers {
      key "tunnel";
      description
        "The iBGP peers, each by a tunnel.";
      leaf tunnel {
        type string;
        description
          "The tunnel.";
      }
      leaf to {
        type string;
        description
          "The edge at its far end.";
      }
      leaf local {
        type inet:ip-address-no-zone;
        description
          "This end's inner address.";
      }
      leaf neighbor {
        type inet:ip-address-no-zone;
        description
          "The far end's.";
      }
      leaf role {
        type enumeration {
          enum client {
            description
              "A client of this edge's reflection (RFC 4456).";
          }
          enum control {
            description
              "The control plane, which reflects.";
          }
        }
        description
          "Where a control plane reflects (Mplify 119 §8.3).";
      }
      leaf cluster-id {
        type string;
        description
          "The reflection's cluster id: an IPv4 address or a number.";
      }
    }
    list unis {
      key "id";
      description
        "The UNIs here that route.";
      leaf id {
        type string;
        description
          "The UNI.";
      }
      leaf end-point {
        type string;
        description
          "Its end point.";
      }
      leaf interface {
        type string;
        description
          "Its interface.";
      }
      uses routing-form;
    }
  }

  grouping dhcp-family {
    description
      "A UNI's family as dnsmasq serves it (MEF 70.2 §11.4, §11.5).";
    leaf mode {
      type string;
      description
        "How the hosts are addressed: dhcp is served.";
    }
    leaf prefix {
      type string;
      description
        "The UNI's subnet.";
    }
    leaf-list provider {
      type inet:ip-address-no-zone;
      description
        "The provider's addresses, the first the hosts' router.";
    }
    leaf-list reserved {
      type string;
      description
        "The prefixes not given out.";
    }
    leaf lease {
      type string;
      description
        "The lease time: a number of s, m, h, d or w, or infinite.";
    }
    leaf-list dns {
      type inet:ip-address-no-zone;
      description
        "The DNS servers told.";
    }
  }

  grouping dhcp-form {
    description
      "The form dnsmasq's file of an instance is rendered from: a
       service at this edge.";
    leaf service {
      type string;
      description
        "The service.";
    }
    leaf fib {
      type uint32;
      description
        "Its FIB, for the file's comment.";
    }
    list unis {
      key "id";
      description
        "Its UNIs here addressed by DHCP.";
      leaf id {
        type string;
        description
          "The UNI.";
      }
      leaf interface {
        type string;
        description
          "Its interface.";
      }
      container ipv4 {
        description
          "IPv4, where served.";
        uses dhcp-family;
      }
      container ipv6 {
        description
          "IPv6, where served.";
        uses dhcp-family;
      }
    }
  }

  grouping dns-form {
    description
      "The form unbound's file of an instance is rendered from: a
       service at this edge, its zones' DNF and PDNS (MEF 138).";
    leaf service {
      type string;
      description
        "The service.";
    }
    leaf fib {
      type uint32;
      description
        "Its FIB, for the file's comment.";
    }
    leaf dot {
      type boolean;
      description
        "DNS over TLS to the clients too, port 853 (D22).";
    }
    leaf-list upstream {
      type string;
      description
        "The servers it asks instead of resolving: address[@port]
         [#name] (D21).";
    }
    leaf upstream-tls {
      type boolean;
      description
        "Asked over TLS.";
    }
    list unis {
      key "id address";
      description
        "Where it listens: a UNI's provider address of each family.";
      leaf id {
        type string;
        description
          "The UNI.";
      }
      leaf address {
        type inet:ip-address-no-zone;
        description
          "The address it listens on.";
      }
      leaf prefix {
        type string;
        description
          "The subnet it answers.";
      }
    }
    list zones {
      key "name";
      description
        "The zones with a DNF or a PDNS, each a view of its own.";
      leaf name {
        type string;
        description
          "The zone.";
      }
      leaf-list prefixes {
        type string;
        description
          "Its prefixes here.";
      }
      container dnf {
        presence
          "A DNF.";
        description
          "Its DNS filtering (MEF 138 §6.1.10).";
        uses sfp-form;
      }
      container pdns {
        presence
          "A PDNS.";
        description
          "Its protective DNS.";
        uses pdns-form;
      }
    }
  }

  grouping proxy-form {
    description
      "The form Squid's file of an instance is rendered from: an SD-WAN
       service's at this edge (flavor sdwan: MEF 138's URLF, MBSF and
       MD+R by zone), or the Security section's URL filter.";
    leaf flavor {
      type enumeration {
        enum sdwan {
          description
            "An SD-WAN service's.";
        }
        enum security {
          description
            "The Security section's.";
        }
      }
      description
        "Whose; none the Security section's.";
    }
    leaf service {
      type string;
      description
        "The service.";
    }
    leaf fib {
      type uint32;
      description
        "Its FIB.";
    }
    list listen {
      key "address";
      description
        "Where it is reached: an SD-WAN service's at each end point's
         own IPv4 address, the Security section's on each address
         told.";
      leaf address {
        type inet:ip-address-no-zone;
        description
          "The address.";
      }
      leaf end-point {
        type string;
        description
          "The end point, an SD-WAN service's.";
      }
    }
    leaf resolver {
      type boolean;
      description
        "The service's resolver is here: names resolved by it.";
    }
    leaf icap {
      type boolean;
      description
        "A zone's MD+R scans: c-icap and ClamAV beside it.";
    }
    list zones {
      key "name";
      description
        "The zones with a URLF, MBSF, MD+R or a DNF's names with a *
         inside, Default last.";
      leaf name {
        type string;
        description
          "The zone.";
      }
      leaf default {
        type boolean;
        description
          "Default: everything.";
      }
      leaf-list prefixes {
        type string;
        description
          "Its prefixes here.";
      }
      leaf-list dnf {
        type string;
        description
          "The DNF's names with a * inside (R71).";
      }
      leaf dnf-id {
        type string;
        description
          "That DNF's ID.";
      }
      container urlf {
        presence
          "A URLF.";
        description
          "Its URL filtering.";
        uses sfp-form;
      }
      container mbsf {
        presence
          "An MBSF.";
        description
          "Its middlebox security.";
        uses mbsf-form;
      }
      container mdr {
        presence
          "An MD+R.";
        description
          "Its malware detection and removal, the hashes ClamAV's
           signatures.";
        uses sfp-form;
      }
    }
    leaf mode {
      type enumeration {
        enum sni {
          description
            "The TLS names looked at.";
        }
        enum inspect {
          description
            "TLS opened.";
        }
      }
      description
        "The Security section's: how TLS is treated.";
    }
    leaf port {
      type inet:port-number;
      description
        "The Security section's: the port the clients are told of,
         3128 unless said.";
    }
    leaf-list allow {
      type string;
      description
        "The Security section's: the networks that may use it.";
    }
    leaf-list deny {
      type string;
      description
        "The Security section's: the domains denied, with the names
         beneath them.";
    }
    leaf malware {
      type boolean;
      description
        "The Security section's: what it fetches scanned by c-icap.";
    }
  }

  typedef ids-size {
    type string {
      pattern '[0-9]{1,6}([kKmMgG][bB])?';
    }
    description
      "A size as Suricata reads one: bytes, or a number of kb, mb or gb
       (64mb, 512kb, 1gb).";
  }

  typedef cpu-set {
    type string {
      length "1..64";
      pattern '[0-9]([0-9,-]*[0-9])?';
    }
    description
      "CPUs and ranges of them, as cpu-affinity has them: 0, 1-3,
       0,2,4-7.";
  }

  typedef eve-type {
    type enumeration {
      enum anomaly {
        description
          "Anomalies of the decoders and parsers.";
      }
      enum http {
        description
          "HTTP's transactions.";
      }
      enum dns {
        description
          "DNS's queries and answers.";
      }
      enum tls {
        description
          "TLS's handshakes.";
      }
      enum ssh {
        description
          "SSH's handshakes.";
      }
      enum flow {
        description
          "Flows as they end.";
      }
      enum netflow {
        description
          "Flows, one record a direction.";
      }
      enum fileinfo {
        description
          "The files seen.";
      }
      enum drop {
        description
          "The packets dropped.";
      }
      enum smtp {
        description
          "SMTP's.";
      }
      enum dhcp {
        description
          "DHCP's.";
      }
      enum smb {
        description
          "SMB's.";
      }
      enum nfs {
        description
          "NFS's.";
      }
      enum ftp {
        description
          "FTP's.";
      }
      enum krb5 {
        description
          "Kerberos 5's.";
      }
      enum snmp {
        description
          "SNMP's.";
      }
      enum sip {
        description
          "SIP's.";
      }
      enum rdp {
        description
          "RDP's.";
      }
      enum mqtt {
        description
          "MQTT's.";
      }
      enum quic {
        description
          "QUIC's.";
      }
      enum http2 {
        description
          "HTTP/2's.";
      }
      enum ike {
        description
          "IKE's.";
      }
      enum rfb {
        description
          "RFB's (VNC).";
      }
      enum dnp3 {
        description
          "DNP3's.";
      }
      enum modbus {
        description
          "Modbus's.";
      }
    }
    description
      "An event type eve.json has beside the alerts.";
  }

  grouping ids-form {
    description
      "The form Suricata's YAML of an instance is rendered from (luxuria
       idsconf.c): an SD-WAN service's at this edge (flavor sdwan: its
       home the UNIs' prefixes, alerts alone), or the Security
       section's, every setting of its page.  What a setting does not
       say is Suricata's default.";
    leaf flavor {
      type enumeration {
        enum sdwan {
          description
            "An SD-WAN service's.";
        }
        enum security {
          description
            "The Security section's.";
        }
      }
      description
        "Whose; none the Security section's.";
    }
    leaf service {
      type string;
      description
        "The service, an SD-WAN service's.";
    }
    leaf-list interfaces {
      type string;
      ordered-by user;
      description
        "The interfaces it captures from: names, any (each up but the
         loopback), or em0^ (a host stack, netmap's alone).";
    }
    leaf-list home {
      type string;
      ordered-by user;
      description
        "HOME_NET: the networks it guards (a.b.c.d/n, x::/n), or any
         alone; none, the private ranges of RFC 1918.";
    }
    leaf ruleset {
      type boolean;
      description
        "The ruleset suricata-update keeps loaded beside its own rules.";
    }
    leaf oneside {
      type boolean;
      description
        "An SD-WAN service's: the edge answers some of the UNIs' traffic
         itself and sees one side of those flows, taken as they come.";
    }
    leaf capture {
      type enumeration {
        enum pcap {
          description
            "By libpcap.";
        }
        enum netmap {
          description
            "By netmap(4).";
        }
      }
      description
        "How it takes the packets; none, pcap.";
    }
    leaf-list pairs {
      type string;
      ordered-by user;
      description
        "netmap's: the pairs it prevents between at L2, copy-mode ips
         both ways (em0:em1, or em0:em0^ its host stack).";
    }
    leaf-list eve {
      type eve-type;
      description
        "What eve.json has beside the alerts.";
    }
    leaf payload {
      type boolean;
      description
        "An alert's payload and packet in eve.json.";
    }
    leaf stats-interval {
      type uint16 {
        range "0..3600";
      }
      units "seconds";
      description
        "Its statistics every so many seconds, 0 none; 10 unless
         said.";
    }
    leaf max-pending {
      type uint16;
      description
        "max-pending-packets; 0 Suricata's default.";
    }
    leaf runmode {
      type enumeration {
        enum autofp {
          description
            "Capture threads, then workers by flow.";
        }
        enum workers {
          description
            "Each thread the whole of a packet's path.";
        }
        enum single {
          description
            "One thread.";
        }
      }
      description
        "Its runmode.";
    }
    leaf autofp-scheduler {
      type enumeration {
        enum hash {
          description
            "By flow.";
        }
        enum ippair {
          description
            "By the pair of addresses.";
        }
        enum ftp-hash {
          description
            "By flow, FTP's data with its control.";
        }
      }
      description
        "autofp's packets to its workers; none, hash.";
    }
    leaf mpm {
      type enumeration {
        enum auto {
          description
            "Suricata's choice.";
        }
        enum ac {
          description
            "Aho-Corasick.";
        }
        enum ac-ks {
          description
            "Aho-Corasick, Ken Steele's.";
        }
        enum hs {
          description
            "Hyperscan.";
        }
      }
      description
        "Its multi-pattern matcher (mpm-algo).";
    }
    leaf profile {
      type enumeration {
        enum low {
          description
            "Less memory.";
        }
        enum medium {
          description
            "Between.";
        }
        enum high {
          description
            "More memory, faster.";
        }
      }
      description
        "Its detection engine's profile.";
    }
    leaf preset {
      type enumeration {
        enum small {
          description
            "A small host.";
        }
        enum medium {
          description
            "A middling one.";
        }
        enum large {
          description
            "A large one.";
        }
      }
      description
        "What a setting not said is, for a host of its size.";
    }
    leaf management-cpus {
      type cpu-set;
      description
        "The CPUs its management threads run on.";
    }
    leaf worker-cpus {
      type cpu-set;
      description
        "The CPUs its workers run on, exclusive.";
    }
    leaf flow-memcap {
      type ids-size;
      description
        "The flow engine's memory.";
    }
    leaf stream-memcap {
      type ids-size;
      description
        "The TCP stream engine's memory.";
    }
    leaf reassembly-memcap {
      type ids-size;
      description
        "Its reassembly's memory.";
    }
    leaf defrag-memcap {
      type ids-size;
      description
        "Defragmentation's memory.";
    }
    leaf host-memcap {
      type ids-size;
      description
        "The host table's memory.";
    }
    leaf http-memcap {
      type ids-size;
      description
        "HTTP's memory.";
    }
    leaf reassembly-depth {
      type ids-size;
      description
        "How far into a TCP stream it inspects.";
    }
    leaf http-request-body {
      type ids-size;
      description
        "How much of a request's body it inspects.";
    }
    leaf http-response-body {
      type ids-size;
      description
        "How much of a response's body it inspects.";
    }
    leaf stream-inline {
      type enumeration {
        enum auto {
          description
            "Inline where it prevents.";
        }
        enum yes {
          description
            "Inline.";
        }
        enum no {
          description
            "Not.";
        }
      }
      description
        "The stream engine inline.";
    }
    leaf midstream {
      type boolean;
      description
        "TCP sessions picked up midstream.";
    }
    leaf exception-policy {
      type enumeration {
        enum auto {
          description
            "Suricata's choice.";
        }
        enum drop-packet {
          description
            "The packet dropped.";
        }
        enum drop-flow {
          description
            "The flow dropped.";
        }
        enum pass-packet {
          description
            "The packet let by.";
        }
        enum pass-flow {
          description
            "The flow let by.";
        }
        enum bypass {
          description
            "The flow bypassed.";
        }
        enum reject {
          description
            "Rejected.";
        }
        enum ignore {
          description
            "Nothing done.";
        }
      }
      description
        "What it does past a limit.";
    }
    leaf pcap-log {
      type boolean;
      description
        "The packets of its alerts kept, a ring of files.";
    }
    leaf pcap-log-limit {
      type ids-size;
      description
        "Each file's size; 100mb unless said.";
    }
    leaf pcap-log-files {
      type uint16 {
        range "1..1000";
      }
      description
        "The files kept; 10 unless said.";
    }
    leaf-list lua-outputs {
      type string;
      ordered-by user;
      description
        "Its Lua scripts run as outputs, each one of its lua.";
    }
    leaf-list plugins {
      type string;
      ordered-by user;
      description
        "The plugins it loads, .so files under /usr/local/lib.";
    }
    leaf-list profiling {
      type enumeration {
        enum rules {
          description
            "The rules' ticks.";
        }
        enum keywords {
          description
            "The keywords'.";
        }
        enum prefilter {
          description
            "The prefilter's.";
        }
        enum rulegroups {
          description
            "The rule groups'.";
        }
        enum packets {
          description
            "The packets'.";
        }
        enum locks {
          description
            "The locks'.";
        }
      }
      description
        "The profiling sections on, where Suricata is built with it.";
    }
    leaf profiling-sample-rate {
      type uint32 {
        range "1..65536";
      }
      description
        "One packet in so many profiled, a power of 2.";
    }
    leaf yaml {
      type string {
        length "0..16384";
      }
      description
        "YAML of the admin's own, appended to what the form made: block
         mappings and sequences of scalars, no key the form sets.";
    }
  }

  grouping instance {
    description
      "A service's instance of a program, in its FIB: the form the
       agent renders the program's configuration from is its list's
       spec, and the text it rendered its conf.";
    leaf name {
      type string;
      description
        "The service's name.";
    }
    leaf fib {
      type uint16;
      description
        "The FIB it runs in (setfib).";
    }
    leaf conf {
      type string;
      config false;
      description
        "The program's configuration text, as the agent rendered it
         from spec.";
    }
    leaf host {
      type string;
      description
        "The host's name, for the files' comments.";
    }
  }

  grouping edge-config {
    description
      "What the console writes to an edge, the host's or a vnet
       jail's: its rules, its steering and its BIRD instances.";
    container rules {
      cg:struct "rules-config";
      description
        "The classification and steering rules, as the console
         compiles them: kept for the next start; with none, the set
         is emptied.";
      leaf set {
        type uint8 {
          range "2..31";
        }
        description
          "The ipfw set they live in, emptied and filled while
           disabled.";
      }
      list table {
        key "name";
        description
          "The lookup tables the rules name.";
        leaf name {
          type string;
          description
            "The table.";
        }
        leaf valtype {
          type enumeration {
            enum skipto {
              description
                "A rule number.";
            }
            enum ipv4 {
              description
                "An IPv4 next hop.";
            }
            enum ipv6 {
              description
                "An IPv6 next hop.";
            }
            enum legacy {
              description
                "A number.";
            }
          }
          description
            "What its values are.";
        }
        list entry {
          key "prefix";
          description
            "Its entries.";
          leaf prefix {
            type string;
            description
              "The key.";
          }
          leaf value {
            type string;
            description
              "The value.";
          }
        }
      }
      leaf-list object {
        type string;
        ordered-by user;
        description
          "dummynet pipes, queues and schedulers, and NAT instances
           the rules name, each as ipfw takes it (pipe N config ...),
           made before the rules, deleted with them.";
      }
      list rule {
        key "index";
        description
          "The rules, in their order: ipfw lets rules share a
           number.";
        leaf index {
          type uint32;
          description
            "Its place, from 0.";
        }
        leaf number {
          type arcfw:rule-number;
          mandatory true;
          description
            "Its number.";
        }
        leaf text {
          type string;
          description
            "Its words.";
        }
      }
      list alt-marking {
        key "service";
        description
          "The services whose tunnels this edge measures by alternate
           marking (RFC 9341, single marking): the colour is the DSCP's
           lowest bit, which no standard class sets, put on by ipfw
           setdscp on the way into each tunnel from a table of the
           set swapped every period (IP_FW_TABLE_XSWAP), counted by
           ipfw count rules at both ends, taken off again on the way
           out of the tunnel and from the outer header.  Its rules and
           tables are the set's (rule 9, first, on the way out of a
           tunnel; rule 11, last, on the way in, before the flows'
           dummynet queues and pipes, which match a class and its
           coloured neighbour); they go and come with it.
           (draft-ietf-ippm-alt-mark-yang's
           ietf-altmark carries no DSCP mark and no counters.)";
        leaf service {
          type string {
            length "1..63";
            pattern '[A-Za-z0-9_.-]+';
          }
          description
            "The service.";
        }
        leaf period {
          type uint16 {
            range "2..3600";
          }
          units "seconds";
          mandatory true;
          description
            "A block's length, L (ietf-altmark's
             measurement-period): blocks begin where the wall clock is
             a multiple of it, so that both ends of a tunnel number
             them alike.";
        }
        list tunnel {
          key "id";
          description
            "Its tunnels with an end at this edge.";
          leaf id {
            type string {
              length "1..127";
            }
            description
              "The tunnel, as both its ends name it.";
          }
          leaf interface {
            type string {
              length "1..15";
            }
            mandatory true;
            description
              "Its interface at this end.";
          }
          leaf outer {
            type inet:ip-address-no-zone;
            description
              "The far end's outer address: the colour is taken off
               the outer header of the tunnel's own packets there.";
          }
          leaf kind {
            type enumeration {
              enum gre {
                description
                  "gre(4): its outer packets GRE.";
              }
              enum gif {
                description
                  "gif(4): IP in IP, or IPv6.";
              }
              enum geneve {
                description
                  "GENEVE: UDP to its port.";
              }
              enum wg {
                description
                  "wg(4): UDP to its port.";
              }
              enum uswe {
                description
                  "Userland ESP: its outer packets not matched; the
                   underlay sees the colour.";
              }
            }
            description
              "Its kind, which says the outer packets' protocol.";
          }
          leaf port {
            type inet:port-number;
            description
              "The far end's UDP port, for wg and GENEVE.";
          }
          leaf ipsec {
            type boolean;
            description
              "IPsec carries it: its outer packets are ESP too.";
          }
        }
      }
      list flow-export {
        key "service";
        description
          "The services whose tunnels' traffic this edge records as
           NetFlow version 9 (RFC 3954): an ng_netflow(4) node a
           service, given a copy of each packet into and out of its
           tunnels by ipfw ngtee through ng_ipfw(4) (rule 12 of the
           set, after alternate marking's), its export9 hook joined to
           an ng_ksocket(4) sending to the collector over UDP from FIB
           0.  The nodes go and come with the set.";
        leaf service {
          type string {
            length "1..63";
            pattern '[A-Za-z0-9_.-]+';
          }
          description
            "The service.";
        }
        leaf collector {
          type inet:ipv4-address-no-zone;
          mandatory true;
          description
            "Where the records go: an IPv4 address, as ng_ksocket's
             inet form takes it.";
        }
        leaf port {
          type inet:port-number {
            range "1..65535";
          }
          default "2055";
          description
            "The collector's UDP port.";
        }
        leaf sampling {
          type uint16 {
            range "1..65535";
          }
          default "1";
          description
            "One packet in so many recorded (ipfw prob); 1, every one.";
        }
        leaf active-timeout {
          type uint16 {
            range "1..65535";
          }
          units "seconds";
          default "1800";
          description
            "A flow still active exported after so long.";
        }
        leaf inactive-timeout {
          type uint16 {
            range "1..65535";
          }
          units "seconds";
          default "15";
          description
            "A flow exported once so long has passed without a packet.";
        }
        list tunnel {
          key "id";
          description
            "Its tunnels with an end at this edge.";
          leaf id {
            type string {
              length "1..127";
            }
            description
              "The tunnel, as both its ends name it.";
          }
          leaf interface {
            type string {
              length "1..15";
            }
            mandatory true;
            description
              "Its interface at this end.";
          }
        }
      }
    }
    container steer {
      cg:struct "steer-config";
      description
        "What the policy tables hold, kept for the next start; made
         again when a probe's state changes.";
      list entry {
        key "table prefix";
        description
          "A prefix's candidates, in the console's order.";
        leaf table {
          type string;
          description
            "The policy table.";
        }
        leaf prefix {
          type string;
          description
            "The prefix.";
        }
        list candidate {
          key "id";
          ordered-by user;
          description
            "The tunnels it may go by, best first.";
          leaf id {
            type string;
            description
              "The tunnel, as the probes know it.";
          }
          leaf via {
            type inet:ip-address-no-zone;
            description
              "The address it goes by.";
          }
        }
      }
      list route {
        key "fib destination";
        description
          "The breakout's routes steered: a destination of a FIB and
           the gateways it may go by, in the console's order, the
           first whose far end the probes do not say is down the
           route.";
        leaf fib {
          type uint16;
          description
            "The FIB.";
        }
        leaf destination {
          type string;
          description
            "The destination.";
        }
        list candidate {
          key "id";
          ordered-by user;
          description
            "The gateways, best first.";
          leaf id {
            type string;
            description
              "The probe target that watches it.";
          }
          leaf via {
            type inet:ip-address-no-zone;
            description
              "The gateway.";
          }
        }
      }
    }
    list bird-instance {
      cg:struct "bird-instance";
      key "name";
      description
        "The BIRD instances of the services, and of the UCS End
         Points that route with the underlay: each file parsed by
         bird -p before it is the instance's; one running told to
         read it again, one not yet started; those not named any more
         stopped.";
      uses instance;
      container spec {
        description
          "The form BIRD's file is rendered from.";
        uses bird-form;
      }
    }
  }

  grouping running {
    description
      "An instance as it runs.";
    leaf name {
      type string;
      description
        "The service.";
    }
    leaf fib {
      type uint16;
      description
        "Its FIB.";
    }
    leaf running {
      type boolean;
      description
        "Its process is there.";
    }
  }

  grouping file {
    description
      "A file of an instance's.";
    leaf path {
      type string;
      description
        "Where.";
    }
    leaf size {
      type uint64;
      units "bytes";
      description
        "How long.";
    }
    leaf at {
      type yang:date-and-time;
      description
        "When last written.";
    }
  }

  container sdwan {
    description
      "The edge.";
    uses edge-config;
    list dhcp-instance {
      key "name";
      description
        "The dnsmasq instances: each checked by dnsmasq --test before
         it is the instance's, one running started again on it.";
      uses instance;
      container spec {
        description
          "The form dnsmasq's file is rendered from.";
        uses dhcp-form;
      }
    }
    list dns-instance {
      key "name";
      description
        "The unbound instances: each checked by
         local-unbound-checkconf, one running started again on it.";
      uses instance;
      container spec {
        description
          "The form unbound's file is rendered from.";
        uses dns-form;
      }
    }
    list proxy-instance {
      key "name";
      description
        "The Squid instances, SD-WAN's and the Security section's
         (sec-): each checked by squid -k parse, one running told to
         reconfigure.";
      uses instance;
      container spec {
        description
          "The form Squid's file is rendered from.";
        uses proxy-form;
      }
      leaf mode {
        type enumeration {
          enum sni {
            description
              "The TLS names looked at, nothing opened.";
          }
          enum inspect {
            description
              "TLS opened, with a CA of the instance's own.";
          }
        }
        description
          "How TLS is treated.";
      }
      list named-list {
        key "name";
        description
          "The files a zone's URLF names, by name.";
        leaf name {
          type string;
          description
            "The list.";
        }
        leaf text {
          type string;
          description
            "Its text.";
        }
      }
      leaf stopped {
        type boolean;
        description
          "Stopped by the admin: kept, not run, nor its c-icap.";
      }
    }
    list ids-instance {
      key "name";
      description
        "The Suricata instances, SD-WAN's and the Security section's
         (sec-): each checked by suricata -T before it runs, one whose
         files changed started again.";
      leaf name {
        type string;
        description
          "The service.";
      }
      leaf-list interface {
        type string;
        ordered-by user;
        description
          "The UNIs it watches.";
      }
      leaf conf {
        type string;
        config false;
        description
          "Suricata's YAML, as the agent rendered it from spec, its
           places filled.";
      }
      leaf rules {
        type string;
        description
          "The service's own rules, one a line.";
      }
      leaf divert {
        type inet:port-number;
        description
          "For one that prevents: the divert port it runs on.";
      }
      leaf host {
        type string;
        description
          "The host's name, for the YAML's comment.";
      }
      container spec {
        description
          "The form Suricata's YAML is rendered from.";
        uses ids-form;
      }
      leaf capture {
        type enumeration {
          enum pcap {
            description
              "By libpcap.";
          }
          enum netmap {
            description
              "By netmap(4).";
          }
        }
        description
          "How it takes the packets, where it does not prevent.";
      }
      leaf offload {
        type boolean;
        description
          "false: its interfaces' offloading turned off as it starts.";
      }
      list lua {
        key "name";
        description
          "Its Lua scripts.";
        leaf name {
          type string;
          description
            "NAME.lua.";
        }
        leaf text {
          type string;
          description
            "The script.";
        }
      }
      leaf-list plugin {
        type string;
        ordered-by user;
        description
          "The plugins it loads, .so files under /usr/local/lib.";
      }
      leaf stopped {
        type boolean;
        description
          "Stopped by the admin: kept, not run.";
      }
      leaf thresholds {
        type string;
        description
          "Its threshold.config lines.";
      }
    }
    list jail {
      key "name";
      description
        "Each edge that is a vnet jail on this host: its rules,
         steering and BIRD, run in it.";
      leaf name {
        type string;
        description
          "The jail.";
      }
      uses edge-config;
    }
    action apply {
      nacm:default-deny-all;
      description
        "A part of an edge set again as running has it, as its
         operation was when sent the same again: what of it is not
         running started (one the admin stopped left so), what runs
         left be.  An edit that changes nothing sets nothing; this
         does.";
      input {
        leaf part {
          type enumeration {
            enum rules {
              description
                "The rules.";
            }
            enum steer {
              description
                "The steering.";
            }
            enum bird {
              description
                "The BIRD instances.";
            }
            enum dhcp {
              description
                "The dnsmasq instances.";
            }
            enum dns {
              description
                "The unbound instances.";
            }
            enum proxy {
              description
                "The Squid instances.";
            }
            enum ids {
              description
                "The Suricata instances.";
            }
          }
          mandatory true;
          description
            "Which.";
        }
        leaf jail {
          type string;
          description
            "The edge that is this vnet jail; none, the host's.";
        }
        leaf security {
          type boolean;
          default "false";
          description
            "For the proxies and the IDS: the Security section's
             (sec-), not SD-WAN's.";
        }
      }
    }
    container state {
      config false;
      description
        "What the edge is doing.";
      uses edge-state;
      list edge {
        key "jail";
        description
          "Each edge that is a vnet jail on this host: its rules and
           steering, its own ipfw's.";
        leaf jail {
          type string;
          description
            "The jail.";
        }
        uses edge-state;
        leaf error {
          type string;
          description
            "Why its ipfw could not be read.";
        }
      }
      list bird {
        description
          "Each BIRD instance, and its protocols.";
        uses running;
        leaf jail {
          type string;
          description
            "The edge that is a vnet jail it runs in; none, the
             host's.";
        }
        list protocol {
          key "name";
          description
            "Its protocols.";
          leaf name {
            type string;
            description
              "The protocol.";
          }
          leaf proto {
            type string;
            description
              "Its kind.";
          }
          leaf state {
            type string;
            description
              "up, down ...";
          }
          leaf info {
            type string;
            description
              "What birdc says beside.";
          }
        }
        list bfd {
          description
            "Its BFD sessions.";
          leaf address {
            type string;
            description
              "The far end.";
          }
          leaf interface {
            type string;
            description
              "The interface.";
          }
          leaf state {
            type enumeration {
              enum up {
                description
                  "Up.";
              }
              enum down {
                description
                  "Down.";
              }
              enum unknown {
                description
                  "Not known.";
              }
            }
            description
              "The session's state.";
          }
          leaf since {
            type string;
            description
              "Since when.";
          }
        }
        container bmp {
          description
            "Its BMP station (RFC 7854) on the agent, when the service
             monitors its routes: what BIRD said of its BGP peers and
             their updates.";
          leaf port {
            type inet:port-number;
            description
              "The station's port, on 127.0.0.1 of the instance's FIB.";
          }
          leaf listening {
            type boolean;
            description
              "The station listens.";
          }
          leaf connected {
            type boolean;
            description
              "BIRD is connected to it.";
          }
          leaf since {
            type yang:date-and-time;
            description
              "Connected, or not, since.";
          }
          leaf sys-name {
            type string;
            description
              "The sysName of BIRD's Initiation.";
          }
          leaf sys-descr {
            type string;
            description
              "The sysDescr of BIRD's Initiation.";
          }
          leaf messages {
            type yang:counter64;
            description
              "The messages read.";
          }
          leaf error {
            type string;
            description
              "Why the connection was last dropped, or the station does
               not listen.";
          }
          list peer {
            key "address distinguisher";
            description
              "A BGP peer BIRD monitors.";
            leaf address {
              type inet:ip-address-no-zone;
              description
                "The peer.";
            }
            leaf distinguisher {
              type uint64;
              description
                "Its route distinguisher; 0 for a global instance's.";
            }
            leaf as {
              type inet:as-number;
              description
                "Its AS.";
            }
            leaf bgp-id {
              type inet:ipv4-address-no-zone;
              description
                "Its BGP identifier.";
            }
            leaf local {
              type inet:ip-address-no-zone;
              description
                "The local address of the session.";
            }
            leaf up {
              type boolean;
              description
                "The session is up.";
            }
            leaf since {
              type yang:date-and-time;
              description
                "Up, or down, since.";
            }
            leaf down-reason {
              type uint8;
              description
                "Why it went down, RFC 7854 4.9's code.";
            }
            leaf announced {
              type yang:counter64;
              description
                "Prefixes announced, before policy.";
            }
            leaf withdrawn {
              type yang:counter64;
              description
                "Prefixes withdrawn, before policy.";
            }
            leaf announced-post {
              type yang:counter64;
              description
                "Prefixes announced, after policy.";
            }
            leaf withdrawn-post {
              type yang:counter64;
              description
                "Prefixes withdrawn, after policy.";
            }
            leaf last {
              type yang:date-and-time;
              description
                "Its last update.";
            }
          }
          list update {
            description
              "The last updates, newest first.";
            leaf time {
              type yang:date-and-time;
              description
                "When it came.";
            }
            leaf peer {
              type inet:ip-address-no-zone;
              description
                "From which peer.";
            }
            leaf policy {
              type enumeration {
                enum pre {
                  description
                    "Before the import policy.";
                }
                enum post {
                  description
                    "After it.";
                }
              }
              description
                "Which RIB-in.";
            }
            leaf action {
              type enumeration {
                enum announce {
                  description
                    "Announced.";
                }
                enum withdraw {
                  description
                    "Withdrawn.";
                }
              }
              description
                "What happened to the prefix.";
            }
            leaf prefix {
              type inet:ip-prefix;
              description
                "The prefix.";
            }
            leaf next-hop {
              type inet:ip-address-no-zone;
              description
                "Its next hop, announced.";
            }
            leaf as-path {
              type string;
              description
                "Its AS path, announced: the AS numbers, sets in
                 braces.";
            }
          }
        }
      }
      list dhcp {
        key "name";
        description
          "Each dnsmasq instance, and the leases it gave.";
        uses running;
        list lease {
          description
            "A lease.";
          leaf expires {
            type yang:date-and-time;
            description
              "When it ends.";
          }
          leaf id {
            type string;
            description
              "The client's identifier (its MAC).";
          }
          leaf address {
            type inet:ip-address-no-zone;
            description
              "The address given.";
          }
          leaf hostname {
            type string;
            description
              "The client's name.";
          }
        }
      }
      list dns {
        key "name";
        description
          "Each unbound instance.";
        uses running;
        leaf tls-cert {
          type string;
          description
            "Its certificate, PEM, where it serves DNS over TLS.";
        }
      }
      list proxy {
        key "name";
        description
          "Each Squid instance.";
        uses running;
        leaf mode {
          type string;
          description
            "sni or inspect.";
        }
        leaf icap {
          type boolean;
          description
            "Its c-icap runs.";
        }
        leaf ca {
          type string;
          description
            "Its CA's certificate, PEM, for the clients to trust
             where TLS is opened.";
        }
      }
      container clamav {
        description
          "ClamAV's signatures, for the proxies that scan for
           malware, as freshclam left them.";
        list database {
          key "name";
          description
            "Each database there.";
          leaf name {
            type string;
            description
              "main, daily or bytecode.";
          }
          leaf file {
            type string;
            description
              "Its file.";
          }
          leaf built {
            type string;
            description
              "When it was built, as its head says.";
          }
          leaf version {
            type int64;
            description
              "Its version.";
          }
          leaf signatures {
            type int64;
            description
              "Its signatures.";
          }
        }
        leaf freshclam {
          type boolean;
          description
            "freshclam runs.";
        }
        leaf conf {
          type boolean;
          description
            "freshclam's configuration is there, and not the port's
             sample.";
        }
        leaf-list mirror {
          type string;
          ordered-by user;
          description
            "Its DatabaseMirror lines.";
        }
        leaf-list log {
          type string;
          ordered-by user;
          description
            "The last lines of its log.";
        }
      }
      list ids {
        key "name";
        description
          "Each Suricata instance, and its latest alerts.";
        leaf name {
          type string;
          description
            "The service.";
        }
        leaf-list interface {
          type string;
          ordered-by user;
          description
            "The UNIs it watches.";
        }
        leaf mode {
          type enumeration {
            enum detect {
              description
                "Watches by libpcap.";
            }
            enum prevent {
              description
                "On a divert port: nothing passes while it is not
                 running.";
            }
          }
          description
            "How it runs.";
        }
        leaf divert {
          type inet:port-number;
          description
            "Its divert port, when it prevents.";
        }
        leaf running {
          type boolean;
          description
            "Its process is there.";
        }
        leaf alerts-seen {
          type uint64;
          description
            "Alerts read in all.";
        }
        list alert {
          description
            "The latest alerts, newest first.";
          leaf time {
            type string;
            description
              "When, as Suricata wrote it.";
          }
          leaf name {
            type string;
            description
              "The signature.";
          }
          leaf source {
            type string;
            description
              "Where from.";
          }
          leaf source-port {
            type inet:port-number;
            description
              "Its port.";
          }
          leaf destination {
            type string;
            description
              "Where to.";
          }
          leaf destination-port {
            type inet:port-number;
            description
              "Its port.";
          }
          leaf proto {
            type string;
            description
              "The protocol.";
          }
          leaf interface {
            type string;
            description
              "Where it came in.";
          }
          leaf signature-id {
            type int64;
            description
              "The signature's id.";
          }
          leaf rev {
            type int64;
            description
              "Its revision.";
          }
          leaf category {
            type string;
            description
              "Its category.";
          }
          leaf severity {
            type int64;
            description
              "Its severity.";
          }
          leaf action {
            type string;
            description
              "allowed or blocked.";
          }
        }
        leaf stopped {
          type boolean;
          description
            "Stopped by the admin.";
        }
        container stats {
          description
            "Its counters as Suricata wrote them, the oldest first.";
          leaf-list field {
            type string;
            ordered-by user;
            description
              "What each value of a row is.";
          }
          list series {
            description
              "A row.";
            leaf-list value {
              type int64;
              ordered-by user;
              description
                "Its values, as field names them.";
            }
          }
          leaf flows {
            type string;
            description
              "The flows by application layer protocol, JSON as the
               agent read them.";
          }
        }
        leaf capture {
          type enumeration {
            enum pcap {
              description
                "libpcap.";
            }
            enum divert {
              description
                "divert(4).";
            }
            enum netmap {
              description
                "netmap(4).";
            }
          }
          description
            "How it takes the packets.";
        }
        list pcap {
          key "path";
          description
            "The packets it logged.";
          uses file;
          leaf from {
            type int64;
            description
              "The time in its name, where it has one.";
          }
        }
        list replay-capture {
          key "path";
          description
            "The captures that came for its replay.";
          uses file;
        }
        leaf replay {
          type string;
          description
            "The last capture replayed through it, JSON as the agent
             wrote it.";
        }
        list offload {
          key "interface";
          description
            "Each interface's offloading still on.";
          leaf interface {
            type string;
            description
              "The interface.";
          }
          leaf-list capability {
            type string;
            ordered-by user;
            description
              "rxcsum, txcsum, tso4 ... as ifconfig(8) names them.";
          }
        }
      }
      container ids-build {
        description
          "What the host's Suricata is built with (--build-info).";
        leaf version {
          type string;
          description
            "Its version.";
        }
        leaf lua {
          type boolean;
          description
            "HAVE_LUA.";
        }
        leaf profiling {
          type boolean;
          description
            "Profiling.";
        }
        leaf profiling-rules {
          type boolean;
          description
            "Rule profiling.";
        }
        leaf profiling-locks {
          type boolean;
          description
            "Lock profiling.";
        }
        leaf hyperscan {
          type boolean;
          description
            "Hyperscan.";
        }
        leaf netmap {
          type boolean;
          description
            "netmap(4).";
        }
        leaf ipfw {
          type boolean;
          description
            "IPFW, divert(4).";
        }
        leaf plugins {
          type boolean;
          description
            "Plugins.";
        }
      }
      container ids-host {
        description
          "The host's CPUs and memory domains, for the instances'
           threads.";
        leaf ncpu {
          type uint32;
          description
            "hw.ncpu.";
        }
        leaf ndomains {
          type uint32;
          description
            "vm.ndomains.";
        }
        list irq {
          key "irq";
          description
            "The interrupts of the instances' interfaces.";
          leaf irq {
            type uint32;
            description
              "Its number.";
          }
          leaf name {
            type string;
            description
              "As hw.intrnames has it.";
          }
          leaf cpus {
            type string;
            description
              "The CPUs it may run on, as cpuset(1) lists them.";
          }
        }
      }
      container ids-ruleset {
        description
          "The ruleset suricata-update fetched, where it has.";
        uses file;
      }
      container record {
        description
          "The security policies' record: what the rules that log to
           the routing socket saw.";
        leaf count {
          type uint64;
          description
            "The day's count.";
        }
        leaf sequence {
          type uint64;
          description
            "The latest number.";
        }
        leaf untold {
          type uint64;
          description
            "Those dropped before they were told.";
        }
        list last {
          description
            "The latest, newest first.";
          leaf time {
            type yang:date-and-time;
            description
              "When.";
          }
          leaf sequence {
            type uint64;
            description
              "Its number.";
          }
          leaf rule {
            type uint32;
            description
              "The rule.";
          }
          leaf action {
            type string;
            description
              "What it did.";
          }
          leaf source {
            type string;
            description
              "Where from.";
          }
          leaf destination {
            type string;
            description
              "Where to.";
          }
          leaf interface {
            type string;
            description
              "On which interface.";
          }
          leaf comment {
            type string;
            description
              "The rule's comment: the policy.";
          }
        }
      }
      list key {
        key "interface";
        description
          "The IPsec keys of the tunnels, by interface
           (sdwan-key-<if>.pem): public parts and times only.";
        leaf interface {
          type string;
          description
            "The tunnel's interface.";
        }
        leaf public {
          type string;
          description
            "Its public key.";
        }
        leaf next {
          type string;
          description
            "The next key's public part, when one waits.";
        }
        leaf keyed-at {
          type yang:date-and-time;
          description
            "When the key was made.";
        }
        leaf lifetime {
          type uint32;
          units "seconds";
          description
            "How long it lives.";
        }
        leaf spi-in {
          type uint32;
          description
            "The inbound SPI.";
        }
        leaf spi-out {
          type uint32;
          description
            "The outbound SPI.";
        }
        leaf next-spi-in {
          type uint32;
          description
            "The next key's inbound SPI.";
        }
        leaf pending {
          type boolean;
          description
            "A rekey waits.";
        }
      }
      list fault {
        description
          "The faults of the day (Mplify 119 Table 5), newest
           first.";
        leaf time {
          type yang:date-and-time;
          description
            "When seen.";
        }
        leaf type {
          type string;
          description
            "Its type.";
        }
        leaf severity {
          type string;
          description
            "Critical, Major, Minor, Warning.";
        }
        leaf was {
          type string;
          description
            "The severity before, when it changed.";
        }
        leaf object {
          type string;
          description
            "What it is about.";
        }
        leaf by {
          type string;
          description
            "What found it.";
        }
        leaf description {
          type string;
          description
            "In words.";
        }
        leaf cleared {
          type boolean;
          description
            "Gone.";
        }
        leaf cleared-at {
          type yang:date-and-time;
          description
            "When it went.";
        }
        leaf compressed {
          type boolean;
          description
            "Others like it before were folded into it.";
        }
      }
    }
  }
}
