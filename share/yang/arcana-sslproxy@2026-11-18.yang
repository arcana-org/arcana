module arcana-sslproxy {
  yang-version 1.1;
  namespace "urn:arcana:yang:arcana-sslproxy";
  prefix arcsslp;

  import ietf-netconf-acm {
    prefix nacm;
    reference
      "RFC 8341: Network Configuration Access Control Model";
  }

  organization
    "Arcana";
  contact
    "Pouria Mousavizadeh Tehrani <pouria@FreeBSD.org>";
  description
    "SSL inspection by SSLproxy (security/sslproxy, sslproxy(1)), a
     plugin, on a FreeBSD host as the agent reads it: whether it is
     installed, enabled and running under Arcana's rc script
     (arcana_sslproxy), the configuration rendered from the form and
     the form itself, the edge's CA (its key made on the host and
     never read out, its certificate an intermediate of the tenant
     fleet's root, which the console keeps), and the ipfw(8) fwd
     rules that send the clients' traffic to it, set 27 at rule 7;
     where an SD-WAN service's MBSF (MEF 138's middlebox, a function
     policy bound to zones) is what it serves, the service, the policy
     and the zones the console compiled the form from.  A jail runs one
     of its own beside the host's (its files beneath its root, its
     rc.conf, its CA): a vnet jail's rules are its own ipfw's, a jail
     of the host's network's the host's, sent to the jail's address.
     Changes are jobs of kind sslproxy (in a jail: the job's jail); the
     CA's key and certificate are this module's actions.";

  revision 2026-11-18 {
    description
      "Initial revision.";
  }

  grouping cert {
    description
      "A certificate as read.";
    leaf subject {
      type string;
      description
        "Its subject, one line.";
    }
    leaf issuer {
      type string;
      description
        "Its issuer, one line.";
    }
    leaf not-after {
      type int64;
      units "seconds";
      description
        "Until when it is valid, seconds since the epoch.";
    }
    leaf pem {
      type string;
      description
        "The certificate, PEM.";
    }
  }

  container sslproxy {
    config false;
    description
      "SSLproxy, read when asked.";
    action read {
      description
        "SSLproxy on the host, or a jail's own: its service,
         configuration, CA and rules.";
      input {
        leaf jail {
          type string;
          description
            "The running jail whose SSLproxy is read; none, the
             host's.";
        }
      }
      output {
        leaf jail {
          type string;
          description
            "The jail read, where one was asked.";
        }
        leaf vnet {
          type boolean;
          description
            "The jail has a network of its own: its rules are its own
             ipfw's, SSLproxy at its loopback; false, the host's ipfw
             fwds to the jail's address.";
        }
        leaf installed {
          type boolean;
          description
            "sslproxy is there.";
        }
        leaf version {
          type string;
          description
            "What sslproxy -V says first.";
        }
        leaf enabled {
          type boolean;
          description
            "arcana_sslproxy_enable.";
        }
        leaf running {
          type boolean;
          description
            "service arcana_sslproxy status says it runs.";
        }
        leaf conf-path {
          type string;
          description
            "The configuration file.";
        }
        leaf ours {
          type boolean;
          description
            "The configuration is the one the form wrote.";
        }
        leaf spec {
          type string;
          description
            "The form it was rendered from, JSON.";
        }
        leaf conf {
          type string;
          description
            "The configuration's text.";
        }
        container bound {
          presence
            "The form is an SD-WAN service's MBSF, compiled by the
             console.";
          description
            "The MEF 138 function policy the form serves: TLS opened for
             the zones it is bound to, SSLproxy run in the service's
             routing table (setfib).";
          leaf service {
            type string;
            description
              "The SD-WAN service.";
          }
          leaf policy {
            type string;
            description
              "Its MBSF's ID.";
          }
          leaf fib {
            type uint32;
            description
              "The service's routing table at this edge.";
          }
          list zone {
            key "name";
            description
              "The zones bound to it, each a fwd rule's clients and
               interfaces.";
            leaf name {
              type string;
              description
                "The zone.";
            }
            leaf-list clients {
              type string;
              description
                "Its prefixes at this edge.";
            }
            leaf-list interfaces {
              type string;
              description
                "The service's UNIs here, where its clients come in.";
            }
          }
        }
        container ca {
          description
            "The edge's CA: its key on the host, never read out.";
          leaf key {
            type boolean;
            description
              "The key is there (ca.key).";
          }
          leaf pending {
            type boolean;
            description
              "A new key waits for its certificate (ca.key.next).";
          }
          leaf csr {
            type string;
            description
              "The request of the key that waits, or of the key in use
               while none waits, PEM.";
          }
          container certificate {
            presence
              "A certificate is installed.";
            description
              "The intermediate the edge forges with (CACert).";
            uses cert;
          }
          container root {
            presence
              "The root it chains to is installed.";
            description
              "The tenant fleet's root (CAChain), what the clients
               trust.";
            uses cert;
          }
        }
        list rule {
          description
            "The fwd rules loaded, set 27, as ipfw -S list says them.";
          leaf number {
            type int32;
            description
              "The rule's number.";
          }
          leaf set {
            type int32;
            description
              "Its set.";
          }
          leaf text {
            type string;
            description
              "The rule, as ipfw writes it.";
          }
        }
        leaf rules-expected {
          type int32;
          description
            "The rules the form makes (the fwd file's lines).";
        }
        leaf rules-file {
          type string;
          description
            "The fwd rules' file, an ipfw(8) file.";
        }
        leaf rules-error {
          type string;
          description
            "Why ipfw's rules could not be read, or why they are left
             alone (another's rule in sets 26 and 27).";
        }
        leaf ip6-redirect {
          type boolean;
          description
            "net.inet6.ip6.redirect of the network whose ipfw has the
             fwd rules: the host's, or a vnet jail's own.  At 0 (the
             sysctl hardening's), forwarded IPv6 takes
             ip6_tryforward(), where a kernel before FreeBSD main
             fb9969ca61ca loses an fwd rule's next hop; the console
             notes such a kernel beside the rules.";
        }
        leaf connect-log {
          type string;
          description
            "The connect log's path, as the configuration has it.";
        }
        leaf connect-log-size {
          type int64;
          units "bytes";
          description
            "Its size.";
        }
      }
    }
    action csr {
      nacm:default-deny-all;
      description
        "The edge's CA key: made (EC P-256, never sent) when there is
         none, or a new one beside the one in use when renew is asked,
         and a certificate request for it.";
      input {
        leaf renew {
          type boolean;
          description
            "A new key, the one in use kept until the new one's
             certificate is installed.";
        }
        leaf jail {
          type string;
          description
            "The running jail whose SSLproxy the key is for, written
             beneath its root alone; none, the host's.";
        }
      }
      output {
        leaf csr {
          type string;
          description
            "The request, PEM.";
        }
      }
    }
    action install-ca {
      nacm:default-deny-all;
      description
        "The edge's CA certificate, an intermediate for the key that
         waits (or the one in use), and the root it chains to: checked
         to be a CA's and the key's, written as CACert and CAChain, the
         waiting key made the one in use; SSLproxy restarted where it
         runs.";
      input {
        leaf certificate {
          type string;
          mandatory true;
          description
            "The intermediate, PEM.";
        }
        leaf chain {
          type string;
          mandatory true;
          description
            "The CAs above it up to the root, PEM.";
        }
        leaf jail {
          type string;
          description
            "The running jail whose SSLproxy's key it is for; none,
             the host's.";
        }
      }
      output {
        leaf subject {
          type string;
          description
            "The installed certificate's subject.";
        }
        leaf not-after {
          type int64;
          units "seconds";
          description
            "Until when it is valid.";
        }
      }
    }
  }
}
