module arcana-probe {
  yang-version 1.1;
  namespace "urn:arcana:yang:arcana-probe";
  prefix arcprobe;

  import cblink-gen {
    prefix cg;
  }
  import ietf-inet-types {
    prefix inet;
    reference
      "RFC 9911: Common YANG Data Types";
  }
  import ietf-yang-types {
    prefix yang;
    reference
      "RFC 9911: Common YANG Data Types";
  }

  organization
    "Arcana";
  contact
    "Pouria Mousavizadeh Tehrani <pouria@FreeBSD.org>";
  description
    "The tunnels a FreeBSD host measures as an SD-WAN edge does
     (Mplify 119 §11.4): each target by STAMP (RFC 8762, its sessions
     arcana-stamp's) or an ICMP echo on a raw socket (root), as its
     kind says, at its interval, with its size and DSCP, down after so
     many misses in a row and up again after so many answers; a
     sample every evaluation interval of the one-way delay (half the
     mean round trip), the delay variation, the loss ratio, the least
     and the most, and the probes sent and answered; thresholds a
     metric over which is a fault (tca).  And measurement intervals
     as RFC 9375's perf-mon has them, for its pm entries: of 60 s,
     aligned to the clock (of 1 to 3600 s as set), each with the
     least, the most, the mean
     and three percentiles of the round trip, the delay each way and
     their IPDV in microseconds, and the loss as a count and a
     percentage; the last 60 kept and the running one; and each class
     of service a target names measured in a session of its own.  The targets are
     configuration, the host's and each vnet jail edge's, with the
     interfaces whose links are watched and the admin's own monitors
     on any tunnel: each edge's lists set together by a commit, kept
     for the agent's next start; what the probes have seen is state.
     The sdwan-probes operation (retired) and the targets of the sdwan
     read of arcana.yaml converted (Y-3); a target that goes down or
     comes up is an arcana-events sdwan-tunnel event.";

  revision 2026-10-15 {
    description
      "Initial revision.";
  }

  typedef ms {
    type decimal64 {
      fraction-digits 3;
    }
    units "milliseconds";
    description
      "Milliseconds.";
  }

  typedef us {
    type yang:gauge64;
    units "microseconds";
    description
      "Microseconds, a measurement interval's figures' unit (RFC
       9375's delay and jitter statistics with lime:microseconds as
       their unit-value).";
  }

  typedef percentile {
    type decimal64 {
      fraction-digits 3;
      range "0..100";
    }
    description
      "A percentile, 0 to 100 to 3 decimal places, as RFC 9375's
       percentile: of a measurement interval's values, the least that
       so many percent of them are less than or equal to (the nearest
       rank); 0.000 for none reported.";
    reference
      "RFC 9375: A YANG Data Model for Network and VPN Service
       Performance Monitoring";
  }

  typedef percentage {
    type decimal64 {
      fraction-digits 5;
      range "0..100";
    }
    description
      "A percentage to 5 decimal places, as RFC 9375's.";
  }

  grouping sample {
    description
      "One evaluation interval's figures.";
    leaf time {
      type yang:date-and-time;
      description
        "When the interval ended.";
    }
    leaf delay {
      type ms;
      description
        "The mean one-way delay: half the mean round trip.";
    }
    leaf ipdv {
      type ms;
      description
        "The mean delay variation.";
    }
    leaf loss {
      type decimal64 {
        fraction-digits 6;
        range "0..1";
      }
      description
        "The loss ratio: probes unanswered over probes sent.";
    }
    leaf min {
      type ms;
      description
        "The least one-way delay.";
    }
    leaf max {
      type ms;
      description
        "The most.";
    }
    leaf sent {
      type uint32;
      description
        "Probes sent.";
    }
    leaf received {
      type uint32;
      description
        "Answered.";
    }
    leaf lost-forward {
      type uint32;
      description
        "By STAMP, of the probes lost, those that never reached a
         stateful reflector (its counter tells them); none when not
         told.";
    }
    leaf lost-backward {
      type uint32;
      description
        "Those it reflected whose reply did not come back.";
    }
    leaf delay-forward {
      type ms;
      description
        "By STAMP, the mean delay out to the reflector: one way, or
         half the round trip (one-way says which).";
    }
    leaf delay-backward {
      type ms;
      description
        "The mean delay back from it.";
    }
    leaf one-way {
      type enumeration {
        enum measured {
          description
            "Every reply of the interval measured each way by the
             clocks (arcana-stamp's delay one-way).";
        }
        enum estimated {
          description
            "Half the round trip each way, an estimate.";
        }
      }
      description
        "How delay-forward and delay-backward were had; none when the
         interval was not measured by STAMP.";
    }
  }

  grouping tca {
    description
      "Threshold crossing alerts (Mplify 119 section 11.4, MEF 105
       section 7.4).";
    container tca {
      cg:struct "tca";
      description
        "Thresholds a metric over which is a fault, cleared under
         it again.";
      leaf delay {
        type ms;
        description
          "The delay's.";
      }
      leaf ipdv {
        type ms;
        description
          "The delay variation's.";
      }
      leaf loss {
        type decimal64 {
          fraction-digits 6;
          range "0..1";
        }
        description
          "The loss ratio's.";
      }
      leaf damping {
        type uint8 {
          range "1..100";
        }
        default "1";
        description
          "Intervals in a row over it before the fault.";
      }
    }
  }

  grouping probing {
    description
      "How a far end is probed.";
    leaf fib {
      type uint16;
      default "0";
      description
        "The table it is reached by.";
    }
    leaf interval {
      type uint32 {
        range "10..60000";
      }
      units "milliseconds";
      default "100";
      description
        "Between two probes.";
    }
    leaf size {
      type uint16 {
        range "8..10000";
      }
      units "bytes";
      default "64";
      description
        "A probe's size.";
    }
    leaf dscp {
      type uint8 {
        range "0..63";
      }
      default "0";
      description
        "The DSCP of the probes.";
    }
    leaf down {
      type uint8 {
        range "1..100";
      }
      default "3";
      description
        "Misses in a row that make it down.";
    }
    leaf up {
      type uint8 {
        range "1..100";
      }
      default "3";
      description
        "Answers in a row that make it up again.";
    }
    leaf timeout {
      type uint32 {
        range "10..60000";
      }
      units "milliseconds";
      default "1000";
      description
        "How long an answer is waited for.";
    }
    leaf eval {
      type uint32 {
        range "100..86400000";
      }
      units "milliseconds";
      default "1000";
      description
        "One sample's interval.";
    }
    leaf history {
      type uint32 {
        range "0..100000";
      }
      default "3600";
      description
        "Samples kept.";
    }
    uses tca;
    uses percentiles;
    leaf measurement-interval {
      type uint32 {
        range "1..3600";
      }
      units "seconds";
      default "60";
      description
        "A measurement interval's length, RFC 9375's
         measurement-interval: the intervals begin where the wall
         clock is a multiple of it.";
    }
  }

  grouping percentiles {
    description
      "The three percentiles of a measurement interval reported, as
       RFC 9375's perf-mon has them (its default high percentile is
       95.000; Arcana's 90.000, the console's SD-WAN tables'
       p10/p50/p90).";
    leaf low-percentile {
      type percentile;
      default "10.000";
      description
        "The low percentile; 0.000 for none.";
    }
    leaf intermediate-percentile {
      type percentile;
      default "50.000";
      description
        "The intermediate percentile; 0.000 for none.";
    }
    leaf high-percentile {
      type percentile;
      default "90.000";
      description
        "The high percentile; 0.000 for none.";
    }
  }

  grouping stats {
    description
      "One metric's statistics over a measurement interval, in
       microseconds, as RFC 9375's delay and jitter statistics: the
       least, the most and the mean of every value, and the three
       percentiles of the raw values kept (all of them unless more
       came than the agent keeps an interval, then a uniform sample
       of them).";
    leaf count {
      type uint32;
      description
        "Values of the interval.";
    }
    leaf min {
      type us;
      description
        "The least.";
    }
    leaf max {
      type us;
      description
        "The most.";
    }
    leaf mean {
      type us;
      description
        "The mean.";
    }
    leaf low-percentile {
      type us;
      description
        "The low percentile's value; none when it is 0.000.";
    }
    leaf intermediate-percentile {
      type us;
      description
        "The intermediate percentile's value.";
    }
    leaf high-percentile {
      type us;
      description
        "The high percentile's value.";
    }
  }

  grouping interval {
    description
      "A target's measurement intervals: aligned to the wall clock (an
       interval of 60 s begins at a minute's start), the last
       completed ones kept, the running one after them.";
    list interval {
      cg:struct "interval";
      key "start";
      description
        "A measurement interval, its probes counted in the interval
         their answer or loss is known in.";
      leaf start {
        type yang:date-and-time;
        description
          "When it began.";
      }
      leaf end {
        type yang:date-and-time;
        description
          "When it ended, or is to end while running.";
      }
      leaf complete {
        type boolean;
        description
          "Ended; false for the running one.";
      }
      leaf sent {
        type uint32;
        description
          "Probes whose answer or loss came in it.";
      }
      leaf received {
        type uint32;
        description
          "Answered.";
      }
      leaf kept {
        type uint32;
        description
          "The raw samples kept, which the percentiles are of: every
           answer's, 4096 at most (a uniform sample of them beyond).";
      }
      container loss {
        description
          "The loss, as RFC 9375's loss statistics: a count and a
           percentage of the probes sent; by STAMP to a stateful
           reflector, each way too.";
        leaf count {
          type uint32;
          description
            "Probes lost.";
        }
        leaf ratio {
          type percentage;
          description
            "Of those sent, a percentage.";
        }
        leaf forward-count {
          type uint32;
          description
            "Lost on the way out (the reflector's counter tells
             them).";
        }
        leaf forward-ratio {
          type percentage;
          description
            "Of those sent.";
        }
        leaf backward-count {
          type uint32;
          description
            "Reflected and lost on the way back.";
        }
        leaf backward-ratio {
          type percentage;
          description
            "Of those sent.";
        }
      }
      container round-trip {
        cg:struct "stats";
        description
          "The two-way delay: the round trip, the reflector's time
           taken out by STAMP.";
        uses stats;
      }
      container forward {
        cg:struct "stats";
        description
          "By STAMP, the one-way delay out, of the answers measured
           one way by both clocks (none estimated).";
        uses stats;
      }
      container backward {
        cg:struct "stats";
        description
          "The one-way delay back.";
        uses stats;
      }
      container jitter {
        description
          "The delay variation, RFC 3393's IPDV between an answer and
           the one before it, as an absolute value.";
        container round-trip {
          cg:struct "stats";
          description
            "Of the round trip.";
          uses stats;
        }
        container forward {
          cg:struct "stats";
          description
            "Of the one-way delay out.";
          uses stats;
        }
        container backward {
          cg:struct "stats";
          description
            "Of the one-way delay back.";
          uses stats;
        }
      }
      container raw {
        description
          "The raw samples kept of the last completed interval, in the
           order they came, for checking the figures: the read action
           with raw alone gives them.";
        leaf-list round-trip {
          type uint32;
          units "microseconds";
          ordered-by user;
          description
            "Round trips.";
        }
        leaf-list forward {
          type uint32;
          units "microseconds";
          ordered-by user;
          description
            "One-way delays out.";
        }
        leaf-list backward {
          type uint32;
          units "microseconds";
          ordered-by user;
          description
            "One-way delays back.";
        }
        leaf-list jitter-round-trip {
          type uint32;
          units "microseconds";
          ordered-by user;
          description
            "The round trip's IPDV.";
        }
        leaf-list jitter-forward {
          type uint32;
          units "microseconds";
          ordered-by user;
          description
            "The delay out's IPDV.";
        }
        leaf-list jitter-backward {
          type uint32;
          units "microseconds";
          ordered-by user;
          description
            "The delay back's IPDV.";
        }
      }
    }
  }

  grouping edge {
    description
      "What an edge measures and watches: the host, or a vnet jail.";
    list target {
      cg:struct "target";
      key "id";
      description
        "A tunnel to measure, SD-WAN's.";
      leaf id {
        type string;
        description
          "The tunnel (TVC), as the console names it.";
      }
      leaf address {
        type inet:ip-address-no-zone;
        mandatory true;
        description
          "Its far end, which answers the echo.";
      }
      leaf kind {
        type enumeration {
          enum auto {
            description
              "The agent's choice: STAMP to an SD-WAN target of the
               host's edge (Arcana's far end, whose stampd answers),
               ICMP its fallback while the reflector does not answer
               (port refused, as many probes unanswered as down, no
               key yet), STAMP tried again every 10 s; ICMP at a
               jail's edge, which has no STAMP yet.";
          }
          enum stamp {
            description
              "STAMP alone (RFC 8762): no fallback, the target down
               while the reflector does not answer, why in
               arcana-stamp's session; refused at a jail's edge.";
          }
          enum icmp {
            description
              "ICMP echo alone: a host that is not Arcana's, a
               breakout's beacon.";
          }
        }
        default "auto";
        description
          "How it is measured; arcana-stamp's session has what STAMP
           sees of it.";
      }
      leaf stamp-interface {
        type string {
          length "1..15";
        }
        description
          "A plain tunnel's (no IPsec, no WireGuard): this end's tunnel
           interface, whose X25519 key pair its STAMP key is derived
           from with the far end's public half; its STAMP then the
           authenticated mode (RFC 8762 section 4.4).";
      }
      leaf stamp-peer {
        type string {
          length "44";
          pattern '[A-Za-z0-9+/]{43}=';
        }
        description
          "The far end's public half of its tunnel's key pair, 32 bytes
           as base64: with stamp-interface, the STAMP key, derived the
           same at both ends by HKDF-SHA256, never sent.  Both or
           neither.";
      }
      list class {
        key "name";
        max-elements 8;
        description
          "A class of service it is measured in too (RFC 9375's
           one-way-pm-statistics-per-class): a session of its own each,
           STAMP with an SSID of its own or ICMP, with the class's DSCP
           in the TOS or traffic class, its intervals apart; no fault
           nor event of its own, the target's state being the target's
           DSCP's.";
        leaf name {
          type string {
            length "1..32";
            pattern '[A-Za-z0-9_.-]+';
          }
          description
            "The class, as the service names it.";
        }
        leaf dscp {
          type uint8 {
            range "0..63";
          }
          mandatory true;
          description
            "Its DSCP: another than the target's and the other
             classes'.";
        }
      }
      leaf count {
        type uint32 {
          range "0..2147483647";
        }
        default "0";
        description
          "How many probes; 0 without end.";
      }
      leaf report {
        type uint16 {
          range "1..1000";
        }
        default "1";
        description
          "Every how many samples one is reported.";
      }
      uses probing;
    }
    list link {
      cg:struct "link";
      key "id";
      description
        "An interface whose link is watched: a fault while it has
         none.";
      leaf id {
        type string;
        description
          "What is on it: the UNI's or the UCS end point's id.";
      }
      leaf interface {
        type string;
        mandatory true;
        description
          "The interface.";
      }
      leaf role {
        type enumeration {
          enum uni {
            description
              "A UNI.";
          }
          enum ucs {
            description
              "A UCS end point.";
          }
        }
        default "ucs";
        description
          "What it is to SD-WAN.";
      }
    }
    list monitor {
      cg:struct "monitor";
      key "name";
      description
        "A tunnel of the admin's measured outside SD-WAN, by the same
         prober: its state and thresholds are events (monitor,
         monitor-threshold), not SD-WAN's faults.";
      leaf name {
        type string {
          length "1..63";
          pattern '[A-Za-z0-9_.@-]+';
        }
        description
          "Its name.";
      }
      leaf interface {
        type string;
        description
          "The tunnel interface it measures.";
      }
      leaf address {
        type inet:ip-address-no-zone;
        description
          "The far end; none, on the host, the interface's own
           (a point-to-point one's), and its FIB with it.";
      }
      uses probing;
    }
  }

  grouping target-state {
    description
      "A target as it is.";
    leaf id {
      type string;
      description
        "The tunnel.";
    }
    leaf address {
      type inet:ip-address-no-zone;
      description
        "Its far end.";
    }
    leaf family {
      type enumeration {
        enum ipv4 {
          description
            "IPv4.";
        }
        enum ipv6 {
          description
            "IPv6.";
        }
      }
      description
        "Its address family.";
    }
    leaf fib {
      type uint16;
      description
        "The table it is reached by.";
    }
    leaf state {
      type enumeration {
        enum unknown {
          description
            "Not yet known.";
        }
        enum up {
          description
            "Answers.";
        }
        enum down {
          description
            "Does not.";
        }
        enum ended {
          description
            "The count ran out.";
        }
        enum error {
          description
            "Could not be probed.";
        }
      }
      description
        "As the probes see it.";
    }
    leaf error {
      type string;
      description
        "Why it could not be probed.";
    }
    leaf since {
      type yang:date-and-time;
      description
        "When the state began.";
    }
    leaf interval {
      type uint32;
      units "milliseconds";
      description
        "Between two probes.";
    }
    leaf size {
      type uint16;
      units "bytes";
      description
        "A probe's size.";
    }
    leaf eval {
      type uint32;
      units "milliseconds";
      description
        "One sample's interval.";
    }
    leaf dscp {
      type uint8;
      description
        "The probes' DSCP.";
    }
    leaf sent {
      type uint64;
      description
        "Probes sent in all.";
    }
    leaf received {
      type uint64;
      description
        "Answered in all.";
    }
    leaf misses {
      type uint32;
      description
        "Misses in a row now.";
    }
    leaf last-rtt {
      type ms;
      description
        "The last round trip.";
    }
    container now {
      description
        "The sample in progress.";
      leaf sent {
        type uint32;
        description
          "Sent.";
      }
      leaf received {
        type uint32;
        description
          "Answered.";
      }
      leaf delay {
        type ms;
        description
          "The one-way delay so far.";
      }
      leaf ipdv {
        type ms;
        description
          "The delay variation so far.";
      }
      leaf loss {
        type decimal64 {
          fraction-digits 6;
        }
        description
          "The loss ratio so far.";
      }
      leaf age {
        type ms;
        description
          "How far into the interval.";
      }
    }
    leaf kept {
      type uint32;
      description
        "Samples kept.";
    }
    list sample {
      cg:struct "sample";
      key "time";
      description
        "The samples kept, oldest first.";
      uses sample;
    }
    leaf class {
      type string;
      description
        "The class of service this row measures (the target's class
         list); none, the target's own DSCP.";
    }
    container pm {
      description
        "Its measurement intervals (RFC 9375's perf-mon, as 5.3 maps
         them): their length, the percentiles they report, and the
         intervals.";
      leaf measurement-interval {
        type uint32;
        units "seconds";
        description
          "Their length.";
      }
      uses percentiles;
      uses interval;
    }
    leaf jail {
      type string;
      description
        "The jail whose edge probes it; none, the host.";
    }
  }

  container probes {
    description
      "The targets, links and monitors of the host and of each vnet
       jail that is an edge, and what the probes have seen.";
    uses edge;
    list jail {
      key "name";
      description
        "An edge that is a vnet jail: probed from its network, its
         lists set apart from the host's and each other's.";
      leaf name {
        type string;
        description
          "The jail.";
      }
      uses edge;
    }
    container state {
      config false;
      description
        "What the probes have seen.";
      leaf probing {
        type boolean;
        description
          "The probe thread runs.";
      }
      leaf time {
        type yang:date-and-time;
        description
          "When read.";
      }
      list target {
        cg:struct "target-state";
        description
          "Each target as it is: the host's, and each jail's edge's,
           whose ids may be the same (both ends of a tunnel).";
        uses target-state;
      }
    }
    action read {
      description
        "What the probes have seen after a time: each target as it
         is, with the samples and the measurement intervals ended
         after the time (the last completed and the running one
         always), a page that has the ones before asks for; when, and
         whether they run.";
      input {
        leaf after {
          type yang:date-and-time;
          description
            "Only samples after this.";
        }
        leaf monitors {
          type boolean;
          default "false";
          description
            "The admin's monitors (the monitor lists') instead of
             SD-WAN's targets, read apart as the monitors operation
             of arcana.yaml read them.";
        }
        leaf raw {
          type boolean;
          default "false";
          description
            "With each target's last completed measurement interval,
             its raw samples, to check its figures by.";
        }
      }
      output {
        leaf probing {
          type boolean;
          description
            "The probe thread runs.";
        }
        leaf time {
          type yang:date-and-time;
          description
            "When read.";
        }
        list target {
          cg:struct "target-state";
          description
            "Each target as it is, its samples after the time; a jail's
             edge's may have the same id as the host's.";
          uses target-state;
        }
      }
    }
  }
}
