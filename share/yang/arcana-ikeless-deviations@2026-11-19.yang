module arcana-ikeless-deviations {
  yang-version 1.1;
  namespace "urn:arcana:yang:arcana-ikeless-deviations";
  prefix arcikld;

  import ietf-i2nsf-ikeless {
    prefix nsfikels;
    reference
      "RFC 9061: A YANG Data Model for IPsec Flow Protection
                 Based on Software-Defined Networking (SDN)";
  }

  organization
    "Arcana";
  contact
    "Pouria Mousavizadeh Tehrani <pouria@FreeBSD.org>";
  description
    "Where Arcana's agent differs from RFC 9061's IKE-less model.

     The SAD and SPD lists are the kernel's, by PF_KEY (RFC 2367):
     running holds the controller's entries, each put in by SADB_ADD
     or SADB_X_SPDADD as it is configured; the operational datastore
     every ESP SA (SADB_DUMP) and every policy (SADB_X_SPDDUMP) of
     the host's network, the controller's under their names and the
     rest (setkey(8)'s, an IKE daemon's, an ipsec(4) interface's, the
     agent's own manual SAs') under the kernel's: an SA
     esp/<destination>/0x<SPI>, a policy spd/<its id>.  Those are
     never changed by an edit.  The notifications name the
     controller's entries by their names.

     FreeBSD's SAs carry no replay statistics but their window and
     sequence counter, and its PF_KEY tells no packet of an unknown
     SPI, so there is no sadb-bad-spi.";

  revision 2026-11-19 {
    description
      "The SAD and SPD lists served; the replay statistics FreeBSD
       does not keep per SA taken away.";
  }
  revision 2026-11-18 {
    description
      "Initial revision.";
  }

  deviation "/nsfikels:ipsec-ikeless/nsfikels:sad/nsfikels:sad-entry/"
          + "nsfikels:ipsec-sa-state/nsfikels:replay-stats/"
          + "nsfikels:replay-window/nsfikels:t" {
    description
      "The kernel tells no SA's highest sequence number seen.";
    deviate not-supported;
  }

  deviation "/nsfikels:ipsec-ikeless/nsfikels:sad/nsfikels:sad-entry/"
          + "nsfikels:ipsec-sa-state/nsfikels:replay-stats/"
          + "nsfikels:replay-window/nsfikels:b" {
    description
      "Nor the lower bound of its window.";
    deviate not-supported;
  }

  deviation "/nsfikels:ipsec-ikeless/nsfikels:sad/nsfikels:sad-entry/"
          + "nsfikels:ipsec-sa-state/nsfikels:replay-stats/"
          + "nsfikels:packet-dropped" {
    description
      "The replays dropped are counted for all SAs at once
       (net.inet.esp.stats), not per SA.";
    deviate not-supported;
  }

  deviation "/nsfikels:ipsec-ikeless/nsfikels:sad/nsfikels:sad-entry/"
          + "nsfikels:ipsec-sa-state/nsfikels:replay-stats/"
          + "nsfikels:failed" {
    description
      "As are the packets failing the window's check.";
    deviate not-supported;
  }

  deviation "/nsfikels:sadb-bad-spi" {
    description
      "FreeBSD's PF_KEY has no such message.";
    deviate not-supported;
  }
}
